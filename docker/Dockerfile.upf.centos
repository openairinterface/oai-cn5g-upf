#---------------------------------------------------------------------
#
# Dockerfile for the OpenAirInterface UPF service
#   Valid for CentOS Stream 10
#
#---------------------------------------------------------------------

#---------------------------------------------------------------------
# BASE IMAGE
#---------------------------------------------------------------------
FROM quay.io/centos/centos:stream10 AS oai-upf-base
ENV IS_DOCKERFILE=1

# ninja-build and the eBPF toolchain headers come from CRB; EPEL is enabled
# for the packages build_helper.upf pulls from it. The rest are in
# BaseOS/AppStream.
RUN dnf config-manager --set-enabled crb && \
    dnf install epel-release -y && \
    dnf update -y && \
    # Log the exact OS release used for the build.
    cat /etc/os-release && \
    dnf -y install \
       diffutils \
       file \
       wget \
       psmisc \
       git && \
    # Libraries built from source are installed under /usr/local, which is not
    # on the default loader path on EL. This is also needed for the ldd check.
    echo "/usr/local/lib" > /etc/ld.so.conf.d/local-lib.conf && \
    echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local-lib.conf

# Copy the workspace as is
WORKDIR /openair-upf
COPY . /openair-upf

# Installing and Building UPF
WORKDIR /openair-upf/build/scripts
RUN ./build_upf --install-deps --force

#---------------------------------------------------------------------
# BUILDER IMAGE
#---------------------------------------------------------------------
FROM oai-upf-base AS oai-upf-builder
RUN ./build_upf --clean --Verbose --build-type Release --jobs && \
    ldd /openair-upf/build/upf/build/upf && \
    mv /openair-upf/build/upf/build/upf /openair-upf/build/upf/build/oai_upf && \
    echo "end of UPF build"

#---------------------------------------------------------------------
# TARGET IMAGE
#---------------------------------------------------------------------
FROM quay.io/centos/centos:stream10-minimal AS oai-upf
ENV TZ=Europe/Paris

# We install some debug tools for the moment in addition of mandatory libraries
RUN microdnf update -y && \
    microdnf install -y \
      tzdata \
      procps-ng \
      psmisc \
      net-tools \
      ethtool \
      iproute \
      iptables-nft \
      llvm-libs \
      initscripts \
      libicu \
      boost \
      libnl3 \
      nettle \
      findutils \
      libconfig && \
    microdnf clean all -y && \
    rm -rf /var/cache/yum /var/cache/dnf

# Copying executable and generated libraries
WORKDIR /openair-upf/bin
COPY --from=oai-upf-builder \
    /openair-upf/build/upf/build/oai_upf \
    /openair-upf/scripts/healthcheck.sh \
    ./

# The libraries built from source. The CMake-built spdlog, fmt, yaml-cpp and
# cpr install into lib64; libbpf is built in place by its own makefile.
COPY --from=oai-upf-builder \
    /usr/local/lib64/libspdlog.so \
    /usr/local/lib64/libfmt.so \
    /usr/local/lib64/libyaml-cpp.so.0.* \
    /usr/local/lib64/libcpr.so.1* \
    /openair-upf/build/ext/libbpf/src/libbpf.so.1 \
    /lib64/
RUN ldconfig && \
    echo "ldd /openair-upf/bin/oai_upf" && \
    ldd /openair-upf/bin/oai_upf && \
    # ldd exits 0 even when a library is missing, so check its output
    ! ldd /openair-upf/bin/oai_upf | grep -q 'not found'

# Copying template configuration files
# The configuration folder will be flat
WORKDIR /openair-upf/etc
COPY --from=oai-upf-builder /openair-upf/etc/config.yaml .

WORKDIR /openair-upf

# expose ports
EXPOSE 2152/udp 8805/udp
# healthcheck
HEALTHCHECK --interval=10s \
            --timeout=15s \
            --retries=6 \
    CMD /openair-upf/bin/healthcheck.sh

CMD ["/openair-upf/bin/oai_upf", "-c", "/openair-upf/etc/config.yaml", "-o"]
