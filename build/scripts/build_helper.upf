# -------------------------------------------------------------------------------
# Install the build and runtime dependencies of the OAI UPF: distribution
# packages, the eBPF toolchain (libbpf, bpftool, netlink) and the libraries
# that are built from source.
# Ubuntu 24.04 and CentOS Stream 10 are the supported distributions.
# -------------------------------------------------------------------------------

GREEN='\033[0;32m'   # ANSI color code for green
RED='\033[0;31m'     # ANSI color code for red
YELLOW='\033[1;93m'  # ANSI color code for brighten yellow
NC='\033[0m'         # ANSI color code to reset to default

# -------------------------------------------------------------------------------
# Include the shared helper functions.
# -------------------------------------------------------------------------------

SCRIPT=$(readlink -f ${BASH_SOURCE})
THIS_SCRIPT_PATH=`dirname $SCRIPT`
COMMON_BUILD_PATH=$THIS_SCRIPT_PATH/../common-build/installation

source $COMMON_BUILD_PATH/build_helper
for helper in fmt spdlog yamlcpp nlohmann cpr; do
  source $COMMON_BUILD_PATH/build_helper.$helper
done

CONFIG_FILE=$THIS_SCRIPT_PATH/../../etc/config.yaml
# Get the kernel version
KERNEL_VERSION=$(uname -r | cut -d'-' -f1,2 | cut -d'.' -f1,2)
# The validated kernel versions for bpf-tool are between 5.7 and 5.15
MAJOR_VERSION=`echo $KERNEL_VERSION | cut -d'.' -f1,1`
MINOR_VERSION=`echo $KERNEL_VERSION | cut -d'.' -f2,2`
if [[ $MAJOR_VERSION -lt 5 ]]; then
  KERNEL_VERSION=5.7
elif [[ $MAJOR_VERSION -gt 5 ]]; then
  KERNEL_VERSION=5.15
elif [[ $MAJOR_VERSION -eq 5 ]]; then
  if [[ $MINOR_VERSION -lt 7 ]]; then
    KERNEL_VERSION=5.7
  elif [[ $MINOR_VERSION -gt 15 ]]; then
    KERNEL_VERSION=5.15
  fi
fi



#-------------------------------------------------------------------------------
install_libbpf_from_git() {
  echo "Install libbpf from source"
  echo ""
  if [ $1 -eq 0 ]; then
    read -p "Do you want to install libbpf ? <y/N> " prompt
    OPTION=""
  else
    prompt='y'
    OPTION="-y"
  fi
  if [ $2 -eq 0 ]; then
    debug=0
  else
    debug=1
  fi

  if [[ $prompt =~ [yY](es)* ]]
  then
    GIT_URL=https://github.com/libbpf/libbpf.git
    GIT_TAG=v1.5.0
    echo "Install libbpf $GIT_TAG from $GIT_URL"
    pushd $OPENAIRCN_DIR/build/ext
    echo "Downloading libbpf"
    # Remove a previous checkout so repeated --install-deps runs are safe.
    $SUDO rm -rf libbpf

    # Checkout to tested version (same form as install_bpftool_from_git).
    # No --depth: shallow fetches negotiate a different protocol that caching
    # proxies and mirrors can reject, and this runs inside docker build.
    git clone --branch $GIT_TAG $GIT_URL
    ret=$?
    if [[ $ret -ne 0 ]]; then
      echo_error "libbpf: git clone $GIT_URL failed (rc=$ret)"
      popd && return $ret
    fi
    if [[ $OS_DISTRO == "ubuntu" ]]; then
      PACKAGE_LIST="\
        make \
        clang \
        $CMAKE \
        binutils-dev \
        libelf-dev \
        libcap-dev \
        libpcap-dev \
        zlib1g-dev \
        llvm \
        python3-docutils"
    elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
      PACKAGE_LIST="\
        make \
        clang \
        $CMAKE \
        binutils-devel \
        libpfm-devel \
        elfutils-devel \
        libpcap \
        libcap-devel \
        zlib-ng-compat-devel \
        llvm \
        python3"
    fi
    $SUDO $INSTALLER install -y $PACKAGE_LIST
    cd libbpf
    ret=$?;[[ $ret -ne 0 ]] && popd && return $ret
    # we used to checkout to 051a4009f94d5633a8f734ca4235f0a78ee90469 (aka v0.3)
    # that was restricting us to build on 5.1xx kernel hosts
    # displaying the checked-out version
    git log -n1
    ret=$?;[[ $ret -ne 0 ]] && popd && return $ret
    cd src && make -j $(nproc)
    ret=$?;[[ $ret -ne 0 ]] && popd && return $ret
    # Install libbpf's own headers (bpf/bpf_helpers.h, bpf/libbpf.h, ...) where
    # CMake looks for them. This does not provide linux/bpf.h and the other
    # linux/ UAPI headers -- those come from the linux-libc-dev package.
    make install_headers DESTDIR=$OPENAIRCN_DIR/build/ext/libbpf/root PREFIX=/usr
    ret=$?;[[ $ret -ne 0 ]] && popd && return $ret
    $SUDO make install
    ret=$?;[[ $ret -ne 0 ]] && popd && return $ret
    popd
  fi
  echo "libbpf installation complete"
  return 0
}


#-------------------------------------------------------------------------------
install_netlink_libraries() {
  echo ""
  echo "Install Netlink libraries:"
  if [[ $OS_DISTRO == "ubuntu" ]]; then
    $SUDO $INSTALLER install -y libnl-3-dev libnl-genl-3-dev libnl-route-3-dev libnl-nf-3-dev
  elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
    $SUDO $INSTALLER install -y libnl3-devel libnl3-cli
  fi
}


#-------------------------------------------------------------------------------
install_bpftool_from_git() {
  echo "Install bpftool from source"
  if [ $1 -eq 0 ]; then
    read -p "Do you want to install bpftool ? <y/N> " prompt
    OPTION=""
  else
    prompt='y'
    OPTION="-y"
  fi
  if [ $2 -eq 0 ]; then
    debug=0
  else
    debug=1
  fi

  # Trick for building on Openshift build: don't build, recover a pre-built version
  #
  if [ -f $OPENAIRCN_DIR/build/ext/bpftool-5-14.tar.gz ]; then
    pushd /
    gzip -cd $OPENAIRCN_DIR/build/ext/bpftool-5-14.tar.gz | $SUDO tar -xvf -
    $SUDO chmod +x /usr/local/sbin/bpftool
    echo "bpftool installation complete"
    popd
    return 0
  fi

  if [[ $prompt =~ [yY](es)* ]]
  then
    GIT_URL=https://github.com/libbpf/bpftool.git
    echo "Install bpftool from $GIT_URL"
    pushd $OPENAIRCN_DIR/build/ext
    echo "Downloading bpftool"
    if [[ $OPTION =~ -[yY](es)* ]]
    then
      $SUDO rm -rf bpftool
    fi

    # Checkout to tested version
    git clone --branch v7.3.0 --recurse-submodules $GIT_URL

    if [[ $OS_DISTRO == "ubuntu" ]]; then
      $SUDO $INSTALLER install -ym wget gcc-multilib
    elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
      $SUDO $INSTALLER install -y wget
    fi

    cd bpftool
    ret=$?;[[ $ret -ne 0 ]] && popd && return $ret
    cd src && CLANG=Nope make -j $(nproc)
    ret=$?;[[ $ret -ne 0 ]] && popd && return $ret
    $SUDO make install
    ret=$?;[[ $ret -ne 0 ]] && popd && return $ret
    popd
  fi
  echo "bpftool installation complete"
  return 0
}


# -------------------------------------------------------------------------------
# Install everything needed to build the UPF: the distribution packages, the
# eBPF toolchain, then the libraries that are built from source.
# -------------------------------------------------------------------------------

# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)

check_install_upf_deps() {

  OPTION=""
  [ $1 -gt 0 ] && OPTION="-y"
  debug=0
  [ $2 -ne 0 ] && debug=1

  echo "Check supported distribution"
  check_supported_distribution || {
    echo_error "$(get_distribution_release) is not a supported distribution"
    return 1
  }

  # prevent lock on /var/lib/dpkg/lock
  if [[ $OS_DISTRO == "ubuntu" ]] && [ $IS_CONTAINER -eq 0 ]; then
    $SUDO sed -i 's/1/0/g' /etc/apt/apt.conf.d/10periodic
  fi

  update_package_db

  check_enable_epel_repos

  # Compilers, generators, ...
  PACKAGE_LIST="\
    autoconf \
    automake \
    $CMAKE \
    git"
  if [[ $OS_DISTRO == "ubuntu" ]]; then
    # build-essential pulls in gcc, g++ and make
    PACKAGE_LIST="$PACKAGE_LIST build-essential"
  elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
    PACKAGE_LIST="$PACKAGE_LIST gcc-c++ make"
  else
    echo_fatal "$OS_DISTRO is not a supported distribution."
  fi
  echo "Install build tools"
  $SUDO $INSTALLER install $OPTION $PACKAGE_LIST || return $?

  # Libraries
  PACKAGE_LIST="\
    libtool \
    openssl \
    ninja-build"
  if [[ $OS_DISTRO == "ubuntu" ]]; then
    PACKAGE_LIST="$PACKAGE_LIST \
      libasio-dev \
      libboost-all-dev \
      libasan8 \
      libconfig++-dev \
      libcurl4t64 \
      libcurl4-gnutls-dev \
      libgmp-dev \
      libidn-dev \
      libidn2-dev \
      libssl-dev \
      nettle-dev \
      net-tools \
      pkg-config"
  elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
    PACKAGE_LIST="$PACKAGE_LIST \
      boost-devel \
      libconfig-devel \
      libgcrypt-devel \
      gmp-devel \
      libidn-devel \
      openssl-devel \
      check \
      nettle-devel \
      libcurl-devel \
      glibc-devel \
      pkgconf-pkg-config \
      libasan"
  else
    echo_fatal "$OS_DISTRO is not a supported distribution."
  fi
  echo "Install distro libs"
  $SUDO $INSTALLER install $OPTION $PACKAGE_LIST || return $?

  echo_info "distro libs installation complete"

  echo ""
  echo -e "$YELLOW NOTE: both datapaths are always built, along with the BPF and"
  echo -e "       netlink libraries they need. enable_bpf_datapath picks between"
  echo -e "       them at run time, and QoS (QER MBR enforcement) works either"
  echo -e "       way: the BPF datapath programmes eBPF TC filters, the simple"
  echo -e "       switch uses tc u32 with action police. $NC"
  echo ""

  install_libbpf_from_git $1 $2 || return $?
  echo ""
  install_bpftool_from_git $1 $2 || return $?
  echo ""
  install_netlink_libraries $1 $2 || return $?

  for lib in fmt spdlog nlohmann cpr libyaml_cpp; do
    install_${lib}_from_git $1 $2 || return $?
  done

  $SUDO ldconfig

  return 0
}

# -------------------------------------------------------------------------------
# Install the minimal set of packages, for a host that only has to run and
# debug an already built UPF.
# -------------------------------------------------------------------------------

# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)

check_install_upf_min_deps() {

  OPTION=""
  [ $1 -gt 0 ] && OPTION="-y"

  echo "Check supported distribution"
  check_supported_distribution || {
    echo_error "$(get_distribution_release) is not a supported distribution"
    return 1
  }

  # prevent lock on /var/lib/dpkg/lock
  if [[ $OS_DISTRO == "ubuntu" ]] && [ $IS_CONTAINER -eq 0 ]; then
    $SUDO sed -i 's/1/0/g' /etc/apt/apt.conf.d/10periodic
  fi

  update_package_db

  check_enable_epel_repos

  # Compilers, generators, ...
  echo "Install build tools"
  $SUDO $INSTALLER install $OPTION gdb || return $?

  # Networking. iproute2 carries tc, which both datapaths use to install the
  # QER rate limiters.
  PACKAGE_LIST="ethtool"
  if [[ $OS_DISTRO == "ubuntu" ]]; then
    PACKAGE_LIST="$PACKAGE_LIST iproute2 iptables vlan"
  elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
    PACKAGE_LIST="$PACKAGE_LIST iproute iptables-nft"
  else
    echo_fatal "$OS_DISTRO is not a supported distribution."
  fi
  echo "Install networking tools"
  $SUDO $INSTALLER install $OPTION $PACKAGE_LIST || return $?

  return 0
}

# -------------------------------------------------------------------------------
# Distribution detection.
# -------------------------------------------------------------------------------

OS_DISTRO=$(grep "^ID=" /etc/os-release | sed "s/ID=//" | sed "s/\"//g")
OS_RELEASE=$(grep "^VERSION_ID=" /etc/os-release | sed "s/VERSION_ID=//" | sed "s/\"//g")

# Echoes the distribution and its release joined, e.g. ubuntu24.04.
get_distribution_release() {
    if [[ ! -z "$OS_DISTRO$OS_RELEASE" ]]; then
        echo "$OS_DISTRO$OS_RELEASE"
    else
        echo Unknown
    fi
}

# Returns 1 where LTTNG is supported: build_upf adds -DUSE_LTTNG=ON on 1.
check_platform_for_lttng() {
  local distribution=$(get_distribution_release)
  if [[ "$distribution" == "ubuntu24.04" ]]; then
      return 1
  fi
  return 0
}
