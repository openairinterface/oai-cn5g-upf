<?xml version="1.0" ?>
<!-- SPDX-License-Identifier: CC-BY-4.0 -->
<mxfile host="app.diagrams.net" type="device" agent="oai-cn5g-upf test suite">
  <diagram name="1 - Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="1-Architecture-1" value="How the pieces fit" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1180" height="52.1" as="geometry"/>
        </mxCell>
        <mxCell id="1-Architecture-2" value="A scenario reaches the UPF two ways: it DRIVES it over PFCP, and it OBSERVES the result. Different paths, different code." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1180" height="36.6" as="geometry"/>
        </mxCell>
        <mxCell id="scenario" value="A SCENARIO&lt;br&gt;&lt;br&gt;arrange()&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;act()&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;verify()&lt;br&gt;&lt;br&gt;one class per file, in upf_test/scenarios/" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="108" width="500" height="118.75000000000001" as="geometry"/>
        </mxCell>
        <mxCell id="1-Architecture-3" value="&amp;lt;- the only thing you write&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;to add a test" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#4a7a3a;align=left;" vertex="1" parent="1">
          <mxGeometry x="855" y="130" width="300" height="52.1" as="geometry"/>
        </mxCell>
        <mxCell id="drive" value="DRIVE&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;the control plane&lt;br&gt;pfcpkit/pfcp/&lt;br&gt;&lt;br&gt;PfcpClient&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;establish_session(spec)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;modify_session(session, delta)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;delete_session(session)&lt;br&gt;&lt;br&gt;codec turns specs into scapy IEs; transport owns&lt;br&gt;the socket, sequence numbers, retries, heartbeats." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#b1d0f0;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="274" width="400" height="188.5" as="geometry"/>
        </mxCell>
        <mxCell id="observe" value="OBSERVE&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;the data plane&lt;br&gt;pfcpkit/capabilities.py&lt;br&gt;&lt;br&gt;three protocols -- named questions, not storage&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;rules&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;which rules are installed?&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;qos&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;what rate is enforced?&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;logs&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;what did the UPF just do?" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="274" width="560" height="137.35000000000002" as="geometry"/>
        </mxCell>
        <mxCell id="adapter" value="THE OAI ADAPTER&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;&amp;nbsp;the KNOWLEDGE&lt;br&gt;upf_test/inspector.py, logs.py, layouts.py, class_ids.py&lt;br&gt;&lt;br&gt;OaiRuleState / OaiQosState / OaiLogs implement the three&lt;br&gt;protocols. This layer holds the facts about this UPF:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;which BPF maps exist, and their key layouts&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;how HTB class ids are derived from (SEID, QFI)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;what its log lines actually say" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffcc99;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="457.35" width="560" height="154.4" as="geometry"/>
        </mxCell>
        <mxCell id="inspect" value="pfcpkit/inspect/&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;&amp;nbsp;the MECHANICS, no UPF knowledge&lt;br&gt;&lt;br&gt;BpfMapInspector(runner, catalogue)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;lt;- catalogue injected&lt;br&gt;TcInspector(runner)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;parses classes, qdiscs&lt;br&gt;LogInspector(runner, container)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;mark() / count_since()&lt;br&gt;layouts.py&amp;nbsp;&amp;nbsp;&amp;nbsp;StructLayout, 15-char name truncation&lt;br&gt;&lt;br&gt;CommandRunner&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;the only subprocess use in the tree&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;DockerExecRunner(&quot;upf-test&quot;)&amp;nbsp;&amp;nbsp;&amp;nbsp;bpftool + tc, IN the container&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;LocalRunner()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;docker logs, on the HOST" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="657.75" width="560" height="173.0" as="geometry"/>
        </mxCell>
        <mxCell id="upf" value="THE UPF UNDER TEST&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;a container, with the eBPF data path enabled&lt;br&gt;&lt;br&gt;answers on N4&amp;nbsp;&amp;nbsp;...&amp;nbsp;&amp;nbsp;and, separately, holds the state the inspectors read back" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;verticalAlign=middle;align=center;fillColor=#1f2430;strokeColor=#3d4451;fontColor=#e6e6e6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="880.75" width="1090" height="78.45" as="geometry"/>
        </mxCell>
        <mxCell id="1-Architecture-4" value="drives" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=3;rounded=0;strokeColor=#6c8ebf;exitX=0.2;exitY=1;entryX=0.5;entryY=0;fontSize=12;fontStyle=1;" edge="1" parent="1" source="scenario" target="drive">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="1-Architecture-5" value="observes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=3;rounded=0;strokeColor=#9673a6;exitX=0.8;exitY=1;entryX=0.5;entryY=0;fontSize=12;fontStyle=1;" edge="1" parent="1" source="scenario" target="observe">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="1-Architecture-6" value="implemented by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=3;rounded=0;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="observe" target="adapter">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="1-Architecture-7" value="asks through" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=3;rounded=0;strokeColor=#d79b00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="adapter" target="inspect">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="1-Architecture-8" value="PFCP requests / responses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=3;rounded=0;strokeColor=#6c8ebf;exitX=0.5;exitY=1;entryX=0.2;entryY=0;fontSize=11;" edge="1" parent="1" source="drive" target="upf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="1-Architecture-9" value="runs bpftool / tc / docker logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=3;rounded=0;strokeColor=#6c8ebf;exitX=0.5;exitY=1;entryX=0.75;entryY=0;fontSize=11;" edge="1" parent="1" source="inspect" target="upf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="seam-note" value="Why the observe path is two boxes deep, and the drive path is one&lt;br&gt;&lt;br&gt;The ADAPTER knows the facts: which maps exist, how a class id is derived from (SEID, QFI), what a log line&lt;br&gt;says. pfcpkit/inspect knows how to run a command and parse what comes back, and nothing else. Swap the&lt;br&gt;adapter and the mechanics still work -- which is most of what porting to another UPF actually costs.&lt;br&gt;&lt;br&gt;The drive path needs no such split because PFCP is PFCP: the same requests address any compliant UPF." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="989.2" width="1090" height="137.35000000000002" as="geometry"/>
        </mxCell>
        <mxCell id="1-Architecture-10" value="Which package each piece belongs to" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="70" y="1160.5500000000002" width="1090" height="36.6" as="geometry"/>
        </mxCell>
        <mxCell id="pkg-lib" value="pfcpkit/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the machinery.&amp;nbsp;&amp;nbsp;Ships no scenarios.&lt;br&gt;&lt;br&gt;PFCP transport and codec, session models, presets, the&lt;br&gt;scenario base class and registry, the three capability&lt;br&gt;protocols, the report -- and inspect/, which can run a&lt;br&gt;command and parse bpftool, tc or log output without&lt;br&gt;knowing what any of it means.&lt;br&gt;&lt;br&gt;Knows PFCP. Knows nothing about any one UPF." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="1186.5500000000002" width="480" height="171.45000000000002" as="geometry"/>
        </mxCell>
        <mxCell id="pkg-adp" value="upf_test/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;everything true only of this UPF&lt;br&gt;&lt;br&gt;the adapter, the BPF map catalogue and key layouts, the&lt;br&gt;HTB class-id arithmetic, this UPF's log strings, the&lt;br&gt;deployment settings, the harness -- and all 16 scenarios.&lt;br&gt;&lt;br&gt;Supplies the catalogue and the patterns that inspect/&lt;br&gt;needs, and picks which runner each tool gets.&lt;br&gt;&lt;br&gt;Depends on pfcpkit. Never the other way round." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="1186.5500000000002" width="480" height="188.5" as="geometry"/>
        </mxCell>
        <mxCell id="1-Architecture-11" value="depends on" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#d79b00;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=11;" edge="1" parent="1" source="pkg-adp" target="pkg-lib">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rule" value="That arrow only ever points one way, and a test enforces it: unit/test_boundary.py parses every pfcpkit module&lt;br&gt;and fails if it imports upf_test. It is what makes the library reusable for a different UPF, which needs an&lt;br&gt;adapter and a harness of its own -- but not a new inspect/, unless it is observed in some entirely new way." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="1401.0500000000002" width="1090" height="69.15" as="geometry"/>
        </mxCell>
        <mxCell id="1-Architecture-12" value="Page 2: how observing works, with the commands.&amp;nbsp;&amp;nbsp;&amp;nbsp;Page 3: how to read a scenario.&amp;nbsp;&amp;nbsp;&amp;nbsp;Page 4: how to extend.&amp;nbsp;&amp;nbsp;&amp;nbsp;Page 5: where every module lives." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="70" y="1486.2000000000003" width="1090" height="35.05" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2 - Observing state">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2-Observingstate-1" value="How a scenario sees what the UPF actually did - and how to check it by hand" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="1590" height="49.0" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-2" value="A PFCP response tells you the UPF SAID yes. The gap between that and the data plane is where the interesting defects live.&lt;br&gt;Every column names the file it lives in. Read left to right: a scenario calls a method, the method is declared once as a protocol, the OAI adapter&lt;br&gt;implements it, and the last column is the command that actually answers it - which you can run yourself." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1590" height="69.15" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-3" value="1.&amp;nbsp;&amp;nbsp;A scenario calls a method" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="118" width="370" height="36.6" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-4" value="upf_test/scenarios/NN-*.py" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Courier New;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="40" y="138" width="370" height="33.5" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-5" value="2.&amp;nbsp;&amp;nbsp;The method is declared here" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="425" y="118" width="390" height="36.6" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-6" value="pfcpkit/capabilities.py" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Courier New;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="425" y="138" width="390" height="33.5" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-7" value="3.&amp;nbsp;&amp;nbsp;The adapter implements it" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="830" y="118" width="350" height="36.6" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-8" value="upf_test/inspector.py, logs.py" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Courier New;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="830" y="138" width="350" height="33.5" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-9" value="4.&amp;nbsp;&amp;nbsp;What runs, and what comes back" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1195" y="118" width="435" height="36.6" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-10" value="against the container" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Courier New;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="1195" y="138" width="435" height="33.5" as="geometry"/>
        </mxCell>
        <mxCell id="q-rules" value="# upf_test/scenarios/04-map_pruning.py&lt;br&gt;&lt;br&gt;class MapPruningOnRemoval(OaiScenario):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;requires = frozenset({&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Capability.RULE_STATE})&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 53&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;...&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def verify(self):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;pdrs_after = self.rules.installed_pdr_ids(seid)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;report.check_absent(..., pdr_id, pdrs_after)&lt;br&gt;&lt;br&gt;installed_pdr_ids(seid)&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;[1, 2]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;which PDR ids does the data plane hold for&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;this session, right now?&quot;&amp;nbsp;&amp;nbsp;&amp;nbsp;Not what the CP&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;asked for - what is actually installed." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="164" width="370" height="297.0" as="geometry"/>
        </mxCell>
        <mxCell id="pr-rules" value="# pfcpkit/capabilities.py&lt;br&gt;&lt;br&gt;class Capability(Enum):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 30&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;RULE_STATE = auto()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;lt;- the name in requires&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;QOS_STATE&amp;nbsp;&amp;nbsp;= auto()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;LOG_WINDOW = auto()&lt;br&gt;&lt;br&gt;@runtime_checkable&lt;br&gt;class RuleState(Protocol):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 45&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def installed_pdr_ids(self, seid) -&amp;gt; list[int]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def installed_qfis(self, seid)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; list[int]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def seid_for_ue_ip(self, ip)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; int | None&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def session_installed(self, seid) -&amp;gt; bool&lt;br&gt;&lt;br&gt;That is the WHOLE vocabulary for rule state.&lt;br&gt;One file, three enum members, three protocols.&lt;br&gt;If a method is not in it, no portable scenario&lt;br&gt;can call it." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="425" y="164" width="390" height="297.0" as="geometry"/>
        </mxCell>
        <mxCell id="ad-rules" value="# upf_test/inspector.py&lt;br&gt;&lt;br&gt;class OaiRuleState:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 35&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def installed_pdr_ids(self, seid):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return self._bpf.pdr_ids_for_seid(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;rules_match_pdr_map&quot;, seid)&lt;br&gt;&lt;br&gt;Knows what the protocol must not:&lt;br&gt;&amp;nbsp;&amp;nbsp;* the map is called rules_match_pdr_map&lt;br&gt;&amp;nbsp;&amp;nbsp;* the kernel truncates that to 15 chars&lt;br&gt;&amp;nbsp;&amp;nbsp;* key {u16 pdr_id; u64 seid} -&amp;gt; &quot;&amp;lt;H6xQ&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;* bpftool must run INSIDE the container,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;because nothing is pinned to bpffs" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffcc99;strokeColor=#d79b00;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="164" width="350" height="297.0" as="geometry"/>
        </mxCell>
        <mxCell id="cmd-rules" value="$ docker exec upf-test /openair-upf/bin/bpftool \&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;--json map dump name rules_match_pdr" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#1f2430;strokeColor=#3d4451;fontColor=#e6e6e6;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1195" y="164" width="435" height="49.0" as="geometry"/>
        </mxCell>
        <mxCell id="out-rules" value="[{ &quot;key&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;[&quot;0x01&quot;,&quot;0x00&quot;, ..x6.., &quot;0x0c&quot;, ...],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;value&quot;: [ ... ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;formatted&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;key&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;{ &quot;pdr_id&quot;: 1, &quot;seid&quot;: 12 },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;value&quot;: { &quot;far&quot;: { &quot;far_id&quot;: ... } } } }]&lt;br&gt;&lt;br&gt;BTF build -&amp;gt; &quot;formatted&quot; is used directly.&lt;br&gt;No BTF&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; StructLayout(&quot;&amp;lt;H6xQ&quot;) decodes the raw&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;bytes to the same {pdr_id: 1, seid: 12}." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1195" y="223.0" width="435" height="238.0" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-rules" target="pr-rules">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pr-rules" target="ad-rules">
