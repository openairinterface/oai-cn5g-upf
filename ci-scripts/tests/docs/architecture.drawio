        <mxCell id="q-qos" value="# upf_test/scenarios/06-qos_rate_change.py&lt;br&gt;&lt;br&gt;class QosRateChange(OaiScenario):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;requires = frozenset({&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Capability.RULE_STATE,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Capability.QOS_STATE})&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;...&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def verify(self):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rate = self.qos.flow_rate_kbps(seid, qfi)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;report.check_eq(..., 20_000, rate[0])&lt;br&gt;&lt;br&gt;flow_rate_kbps(seid, qfi)&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;(50000, 100000)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;what rate and ceiling are actually enforced&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;for this QoS flow?&quot;&amp;nbsp;&amp;nbsp;&amp;nbsp;Returns None when there&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;is no enforcement at all - never (0, 0), so&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;absent&quot; stays distinct from &quot;zero&quot;." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="483.0" width="370" height="312.5" as="geometry"/>
        </mxCell>
        <mxCell id="pr-qos" value="# pfcpkit/capabilities.py&lt;br&gt;&lt;br&gt;@runtime_checkable&lt;br&gt;class QosState(Protocol):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 66&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def flow_exists(self, seid, qfi)&amp;nbsp;&amp;nbsp;-&amp;gt; bool&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def flow_rate_kbps(self, seid, qfi)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; tuple[int, int] | None&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def session_shaper_exists(self, seid) -&amp;gt; bool&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def shaper_root_exists(self)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; bool&lt;br&gt;&lt;br&gt;&quot;Protocol&quot; is typing.Protocol - structural typing.&lt;br&gt;An adapter does NOT inherit from it; it just&lt;br&gt;defines methods with matching names, and mypy&lt;br&gt;checks the match. That is why a project can wrap&lt;br&gt;a client object it already has." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="425" y="483.0" width="390" height="312.5" as="geometry"/>
        </mxCell>
        <mxCell id="ad-qos" value="# upf_test/inspector.py&amp;nbsp;&amp;nbsp;+&amp;nbsp;&amp;nbsp;class_ids.py&lt;br&gt;&lt;br&gt;class OaiQosState:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 83&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def flow_handle(self, seid, qfi):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return handle(qos_class_minor(seid, qfi))&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def _flow_class(self, seid, qfi):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return self._tc.class_by_handle(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self._iface, self.flow_handle(seid, qfi))&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def flow_rate_kbps(self, seid, qfi):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;entry = self._flow_class(seid, qfi)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;...&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return entry.rate_kbps, entry.ceil_kbps&lt;br&gt;&lt;br&gt;The class id is DERIVED, not discovered:&lt;br&gt;&amp;nbsp;&amp;nbsp;session:&amp;nbsp;&amp;nbsp;seid &amp;amp; 0xFFFF&lt;br&gt;&amp;nbsp;&amp;nbsp;flow:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;hash of (seid, qfi), no counter&lt;br&gt;&lt;br&gt;seid=0x14, qfi=5&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;flow&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;1:cd&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;session 1:14" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffcc99;strokeColor=#d79b00;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="483.0" width="350" height="312.5" as="geometry"/>
        </mxCell>
        <mxCell id="cmd-qos" value="$ docker exec upf-test tc class show dev n3" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#1f2430;strokeColor=#3d4451;fontColor=#e6e6e6;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1195" y="483.0" width="435" height="33.5" as="geometry"/>
        </mxCell>
        <mxCell id="out-qos" value="class htb 1:14 root&amp;nbsp;&amp;nbsp;rate 10Gbit ceil 10Gbit&lt;br&gt;class htb 1:cd parent 1:14 prio 0 \&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rate 50Mbit ceil 100Mbit&lt;br&gt;&lt;br&gt;-&amp;gt;&amp;nbsp;&amp;nbsp;flow_rate_kbps(0x14, 5) == (50000, 100000)&lt;br&gt;&lt;br&gt;Gotcha: tc -j works for qdisc show but is SILENTLY&lt;br&gt;ignored for class show on iproute2 5.15, so the text&lt;br&gt;parser is the path actually used. Both are supported." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1195" y="526.5" width="435" height="269.0" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-qos" target="pr-qos">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pr-qos" target="ad-qos">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ad-qos" target="cmd-qos">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="q-logs" value="# upf_test/scenarios/12-rebuild_once.py&lt;br&gt;&lt;br&gt;class RebuildOnce(OaiScenario):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;requires = frozenset({&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Capability.LOG_WINDOW})&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;...&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def act(self):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.mark = self.logs.mark()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.modify(...)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# the one thing&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def verify(self):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;n = self.logs.stable_pipeline_&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rebuilds_since(self.mark, seid)&lt;br&gt;&lt;br&gt;mark() is a POSITION in the log, taken before the&lt;br&gt;operation. Every *_since(mark) call then reads only&lt;br&gt;what arrived after it, so a count belongs to one&lt;br&gt;request rather than to the whole run." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="817.5" width="370" height="281.5" as="geometry"/>
        </mxCell>
        <mxCell id="pr-logs" value="# pfcpkit/capabilities.py&lt;br&gt;&lt;br&gt;@runtime_checkable&lt;br&gt;class LogSource(Protocol):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 107&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def mark(self)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; LogMarker&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def find_since(self, mark, pattern) -&amp;gt; list[str]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def count_since(self, mark, pattern) -&amp;gt; int&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def stable_count_since(self, mark, pattern)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def errors_since(self, mark, ignore=())&lt;br&gt;&lt;br&gt;Windowing ONLY - no log pattern appears here,&lt;br&gt;because log strings are true of one implementation.&lt;br&gt;&lt;br&gt;stable_pipeline_rebuilds_since() is therefore NOT in&lt;br&gt;this file: it is an adapter EXTRA. That is why the&lt;br&gt;scenario reaches it through self.logs (typed OaiLogs)&lt;br&gt;and not through self.ctx.logs (typed LogSource)." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="425" y="817.5" width="390" height="281.5" as="geometry"/>
        </mxCell>
        <mxCell id="ad-logs" value="# upf_test/logs.py&lt;br&gt;&lt;br&gt;class OaiLogs:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# wraps LogInspector&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def stable_pipeline_rebuilds_since(mark, seid):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return self._logs.stable_count_since(mark,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rf&quot;Modify Pipeline - Updating .. &quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rf&quot;session 0x0*{seid:x}\b&quot;)&lt;br&gt;&lt;br&gt;Also here: tc_failures_since, qos_setups_since,&lt;br&gt;attach_refusals_since, pipeline_creates_since.&lt;br&gt;&lt;br&gt;docker logs is a HOST operation, so this one gets&lt;br&gt;LocalRunner, not the docker-exec runner." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffcc99;strokeColor=#d79b00;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="817.5" width="350" height="281.5" as="geometry"/>
        </mxCell>
        <mxCell id="cmd-logs" value="$ docker logs upf-test 2&amp;gt;&amp;amp;1 | grep \&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;'Modify Pipeline - Updating .* 0x14'" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#1f2430;strokeColor=#3d4451;fontColor=#e6e6e6;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1195" y="817.5" width="435" height="49.0" as="geometry"/>
        </mxCell>
        <mxCell id="out-logs" value="[eBPF] Modify Pipeline - Updating .. session 0x14&lt;br&gt;[eBPF] Modify Pipeline - Updating .. session 0x14&lt;br&gt;...&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;one line per reprogramming pass&lt;br&gt;&lt;br&gt;One request should produce ONE line. rebuild_once&lt;br&gt;measured 25 for a request carrying 4 removal IEs.&lt;br&gt;&lt;br&gt;Two traps this layer handles for you:&lt;br&gt;&amp;nbsp;&amp;nbsp;* stderr must merge at the fd level or the window&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;points at the wrong place (libbpf uses stderr)&lt;br&gt;&amp;nbsp;&amp;nbsp;* docker logs lags - poll until the count settles" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1195" y="876.5" width="435" height="222.5" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-logs" target="pr-logs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pr-logs" target="ad-logs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="2-Observingstate-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ad-logs" target="cmd-logs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2-wiring" value="What joins the three columns together - and where to look when it goes wrong&lt;br&gt;&lt;br&gt;1.&amp;nbsp;&amp;nbsp;pfcpkit/scenarios/context.py declares the FIELD TYPES:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rules: RuleState&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;qos: QosState&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;logs: LogSource&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;So self.ctx.rules is only ever known to have the four methods in column 2. That is what stops a&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;portable scenario from naming a map.&lt;br&gt;&lt;br&gt;2.&amp;nbsp;&amp;nbsp;upf_test/harness.py:79 does the WIRING, and is the only place that does:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ScenarioContext(rules=OaiRuleState(bpf), qos=OaiQosState(tc, n3), logs=OaiLogs(...),&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;capabilities=CAPABILITIES, adapter=ADAPTER_NAME)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;At runtime the field holds the column-3 object; at type-check time it is the column-2 protocol.&lt;br&gt;&lt;br&gt;3.&amp;nbsp;&amp;nbsp;upf_test/inspector.py:28 declares what this adapter can serve:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;CAPABILITIES = frozenset({Capability.RULE_STATE, Capability.QOS_STATE, Capability.LOG_WINDOW})&lt;br&gt;&lt;br&gt;4.&amp;nbsp;&amp;nbsp;run_scenarios.py:116 compares the two BEFORE running anything:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;runnable, skipped = partition_by_capability(scenarios, CAPABILITIES)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;missing = scenario.requires - CAPABILITIES&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;skipped, and logged by name:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;skipping qos_rate_change: adapter oai-upf does not provide QOS_STATE&quot;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1121.0" width="1140" height="312.5" as="geometry"/>
        </mxCell>
        <mxCell id="p2-plain" value="So, in one sentence each&lt;br&gt;&lt;br&gt;Capability.RULE_STATE&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;a NAME for &quot;this adapter can read back rule&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;state&quot;. An enum member in capabilities.py,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nothing more.&lt;br&gt;&lt;br&gt;requires = {RULE_STATE}&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;the scenario saying &quot;I need that&quot;. Compared&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;against the adapter's CAPABILITIES before the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;run; a mismatch is a REPORTED skip, never a&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;silent one.&lt;br&gt;&lt;br&gt;RuleState (Protocol)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;the four method signatures that capability&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;entitles a scenario to call. A vocabulary,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;with no implementation.&lt;br&gt;&lt;br&gt;installed_pdr_ids(seid)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;one of those four. &quot;Which PDR ids are installed&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;for this session?&quot; - answered by the adapter,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;however that UPF can answer it." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1195" y="1121.0" width="435" height="359.0" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 - Reading a scenario">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="3-Readingascenario-1" value="How to read a test" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="1590" height="49.0" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-2" value="Left: the machinery, quoted from the file it lives in. Right: two real scenarios, quoted from theirs.&lt;br&gt;The four hooks are the whole interface. Everything else on this page is either what calls them, or what they call." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1590" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-3" value="The machinery" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="118" width="430" height="36.6" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-4" value="pfcpkit/scenarios/base.py, report.py" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Courier New;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="40" y="138" width="430" height="33.5" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-5" value="A scenario that asserts on state" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="490" y="118" width="545" height="36.6" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-6" value="upf_test/scenarios/06-*.py" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Courier New;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="490" y="138" width="545" height="33.5" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-7" value="A scenario that asserts on the log" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1050" y="118" width="545" height="36.6" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-8" value="upf_test/scenarios/12-*.py" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Courier New;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="1050" y="138" width="545" height="33.5" as="geometry"/>
        </mxCell>
        <mxCell id="lc-execute" value="# pfcpkit/scenarios/base.py&lt;br&gt;&lt;br&gt;def execute(self):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 79&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;try:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.arrange()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# preconditions&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.act()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# the one operation&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.verify()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# assertions&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;except ScenarioAborted as exc:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 86&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.report.abort(f&quot;aborted: {exc}&quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;except Exception as exc:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 89&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.report.error(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;f&quot;unhandled {type(exc).__name__}: {exc}&quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;finally:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self._safe_teardown()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 93&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return self.report&lt;br&gt;&lt;br&gt;Read the try/finally, not the prose: verify is&lt;br&gt;skipped when act raises, teardown runs either way,&lt;br&gt;and nothing propagates. execute is the skeleton --&lt;br&gt;you override the four hooks, never this." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#b1d0f0;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="164" width="430" height="328.0" as="geometry"/>
        </mxCell>
        <mxCell id="lc-hooks" value="# pfcpkit/scenarios/base.py&lt;br&gt;&lt;br&gt;def arrange(self):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;...&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 100, optional&lt;br&gt;@abstractmethod&lt;br&gt;def act(self):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;...&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 108, REQUIRED&lt;br&gt;@abstractmethod&lt;br&gt;def verify(self):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;...&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 112, REQUIRED&lt;br&gt;def teardown(self):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 115, optional&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;for session in reversed(self._owned):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if session.active:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.ctx.client.delete_session(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;session, tolerate_failure=True)&lt;br&gt;&lt;br&gt;Only act and verify are @abstractmethod, so a scenario&lt;br&gt;that forgets one will not instantiate. arrange defaults&lt;br&gt;to a no-op, which suits a scenario whose subject IS the&lt;br&gt;establishment.&lt;br&gt;&lt;br&gt;teardown deletes what establish tracked, newest&lt;br&gt;first, tolerating failure -- so cleanup cannot turn a&lt;br&gt;test failure into a crash." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="506.0" width="430" height="343.5" as="geometry"/>
        </mxCell>
        <mxCell id="lc-helpers" value="# pfcpkit/scenarios/base.py -- what a scenario calls&lt;br&gt;&lt;br&gt;def establish(self, spec):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 151&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;session = self.ctx.client.establish_session(spec)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self._owned.append(session)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# &amp;lt;- teardown&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.report.require(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;session establishment accepted&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;session.addressable and session.active, ...)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return session&lt;br&gt;&lt;br&gt;def require_pdrs_installed(self, seid, pdr_ids):&amp;nbsp;&amp;nbsp;# 134&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;installed = self.ctx.rules.installed_pdr_ids(seid)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;missing = [i for i in pdr_ids if i not in installed]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.report.require(..., not missing, ...)&lt;br&gt;&lt;br&gt;def modify(self, session, delta)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 167&lt;br&gt;def delete(self, session)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 171&lt;br&gt;def ue_ip(self)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 128&lt;br&gt;&lt;br&gt;Both require calls raise ScenarioAborted on failure,&lt;br&gt;which execute catches at line 86. That is the whole&lt;br&gt;mechanism behind &quot;act never runs on a bad precondition&quot;." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="863.5" width="430" height="359.0" as="geometry"/>
        </mxCell>
        <mxCell id="lc-report" value="# pfcpkit/report.py -- recording the result&lt;br&gt;&lt;br&gt;report.check(desc, cond, detail)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# soft&lt;br&gt;report.check_eq(desc, expected, actual)&amp;nbsp;&amp;nbsp;&amp;nbsp;# soft&lt;br&gt;report.check_count(desc, expected, actual) # soft&lt;br&gt;report.check_in / check_absent(...)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# soft&lt;br&gt;report.warn(message)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# not a failure&lt;br&gt;report.require(desc, cond, detail)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# HARD: aborts&lt;br&gt;&lt;br&gt;Soft means recorded and carry on, so one failed check&lt;br&gt;never hides the rest of a scenario. ok is&lt;br&gt;failed == 0 and passed &amp;gt; 0, so a scenario that&lt;br&gt;asserted nothing is NOT a pass.&lt;br&gt;&lt;br&gt;Prefer check_eq / check_count / check_absent over bare&lt;br&gt;check: they build the &quot;expected X, got Y&quot; detail, so a&lt;br&gt;failure reads without opening the source." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1236.5" width="430" height="281.5" as="geometry"/>
        </mxCell>
        <mxCell id="a-head" value="upf_test/scenarios/06-qos_rate_change.py&lt;br&gt;&lt;br&gt;&quot;An Update QER changes the enforced rate and ceiling&quot;&lt;br&gt;requires = {RULE_STATE, QOS_STATE}&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ue_index = 14" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="164" width="545" height="80.0" as="geometry"/>
        </mxCell>
        <mxCell id="a-arrange" value="def arrange(self):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 57&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.qer = presets.gbr_qer(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;gbr_dl_kbps=50_000, mbr_dl_kbps=100_000)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.session = self.establish(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;presets.basic_ipv4_session(settings,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ue_ipv4=self.ue_ip(), ul_teid=0x1410,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;dl_teid=0x1411, qer=self.qer))&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;seid = self.session.require_up_seid()&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# this is what CREATES the enforcement state&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.modify(self.session,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ModificationSpec(update_qers=(self.qer,)))&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.before = self.qos.flow_rate_kbps(seid, self.qfi)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.report.require(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;QoS enforcement exists for the flow before &quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;the rate change&quot;, self.before is not None, ...)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="258.0" width="545" height="281.5" as="geometry"/>
        </mxCell>
        <mxCell id="a-act" value="def act(self):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 87&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.response = self.modify(self.session,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ModificationSpec(update_qers=(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.qer.with_bitrates(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;gbr_dl_kbps=20_000,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;mbr_dl_kbps=40_000),)))&lt;br&gt;&lt;br&gt;One request. Nothing else in act()." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="553.5" width="545" height="142.0" as="geometry"/>
        </mxCell>
        <mxCell id="a-verify" value="def verify(self):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 99&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;report.check(&quot;modification accepted&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.response.accepted)&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;updated = self.qos.flow_rate_kbps(seid, self.qfi)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;report.check(&quot;the QoS flow still has enforcement &quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;state after the rate change&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;updated is not None, ...)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if updated is None:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# nothing to compare&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;report.check_eq(&quot;enforced rate matches the updated &quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;GBR&quot;, 20_000, updated[0])&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;report.check_eq(&quot;enforced ceil matches the updated &quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;MBR&quot;, 40_000, updated[1])&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if updated == self.before:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;report.warn(&quot;rate/ceil unchanged at ... : the &quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;update was not applied at all, rather &quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;than applied incorrectly&quot;)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="709.5" width="545" height="328.0" as="geometry"/>
        </mxCell>
        <mxCell id="a-note" value="Three things to take from this one&lt;br&gt;&lt;br&gt;* the modify() in arrange() is not filler. This UPF creates&lt;br&gt;&amp;nbsp;&amp;nbsp;enforcement state in ModifyPipeline only, so without it&lt;br&gt;&amp;nbsp;&amp;nbsp;there is nothing for act() to update.&lt;br&gt;* the early return when updated is None. Comparing rates&lt;br&gt;&amp;nbsp;&amp;nbsp;against a class that does not exist would add two&lt;br&gt;&amp;nbsp;&amp;nbsp;confusing failures on top of the real one.&lt;br&gt;* warn() separates &quot;unchanged&quot; from &quot;wrong value&quot;.&lt;br&gt;&amp;nbsp;&amp;nbsp;Unchanged means not applied AT ALL -- and the PFCP&lt;br&gt;&amp;nbsp;&amp;nbsp;response is an accept either way." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="1051.5" width="545" height="188.5" as="geometry"/>
        </mxCell>
        <mxCell id="a-out" value="$ ./run_scenarios.py --scenario qos_rate_change&lt;br&gt;&lt;br&gt;== qos_rate_change: FAIL ==&lt;br&gt;&amp;nbsp;&amp;nbsp;[PASS ] session establishment accepted&lt;br&gt;&amp;nbsp;&amp;nbsp;[PASS ] QoS enforcement exists ... before the rate change&lt;br&gt;&amp;nbsp;&amp;nbsp;[PASS ] modification accepted&lt;br&gt;&amp;nbsp;&amp;nbsp;[PASS ] the QoS flow still has enforcement state ...&lt;br&gt;&amp;nbsp;&amp;nbsp;[FAIL ] enforced rate matches the updated GBR&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; expected 20000, got 50000&lt;br&gt;&amp;nbsp;&amp;nbsp;[FAIL ] enforced ceil matches the updated MBR&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; expected 40000, got 100000&lt;br&gt;&amp;nbsp;&amp;nbsp;[WARN ] rate/ceil unchanged at (50000, 100000) kbps: ...&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;4 passed, 2 failed, 1 warning(s)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#1f2430;strokeColor=#3d4451;fontColor=#e6e6e6;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="1254.0" width="545" height="219.5" as="geometry"/>
        </mxCell>
        <mxCell id="b-head" value="upf_test/scenarios/12-rebuild_once.py&lt;br&gt;&lt;br&gt;&quot;A modification with N removals rebuilds the datapath&lt;br&gt; exactly once&quot;&lt;br&gt;requires = {LOG_WINDOW}&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ue_index = 10" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="164" width="545" height="95.5" as="geometry"/>
        </mxCell>
        <mxCell id="b-arrange" value="def arrange(self):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 52&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.session = self.establish(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;presets.multi_flow_session(settings,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ue_ipv4=self.ue_ip(),&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ul_teid=0x1010, dl_teid=0x1011,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;extra_ul_teid=0x1012, extra_dl_teid=0x1013))&lt;br&gt;&lt;br&gt;Two QoS flows: 4 PDRs, 4 FARs, 2 QERs.&lt;br&gt;&lt;br&gt;No state assertion here -- what this measures is the&lt;br&gt;rebuild COUNT, not the prior rule state." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="273.5" width="545" height="188.5" as="geometry"/>
        </mxCell>
        <mxCell id="b-act" value="def act(self):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 65&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;spec = self.session.spec&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;doomed_qer&amp;nbsp;&amp;nbsp;= spec.qer(presets.EXTRA_QER_ID)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;doomed_pdrs = spec.pdrs_for_qer(doomed_qer.qer_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.delta = ModificationSpec(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;remove_pdr_ids=tuple(p.pdr_id for p in doomed_pdrs),&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;remove_far_ids=spec.far_ids_exclusive_to(doomed_pdrs),&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;remove_qer_ids=(doomed_qer.qer_id,))&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.mark = self.logs.mark()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# &amp;lt;- window opens&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.response = self.modify(self.session, self.delta)&lt;br&gt;&lt;br&gt;4 removal IEs, 1 request." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="476.0" width="545" height="219.5" as="geometry"/>
        </mxCell>
        <mxCell id="b-verify" value="def verify(self):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# line 82&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;report.check(&quot;modification accepted&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.response.accepted,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;f&quot;cause={self.response.cause} &quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;f&quot;failed_rule={self.response.failed_rule_id}&quot;)&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rebuilds = self.logs.stable_pipeline_rebuilds_since(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;self.mark, seid)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;report.check_count(&quot;datapath rebuilt exactly once &quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;for the whole modification&quot;, 1, rebuilds)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if rebuilds &amp;gt; 1:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;report.warn(f&quot;{rebuilds} rebuilds for &quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;f&quot;{self.delta.removal_count} removal IE(s) ...&quot;)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="709.5" width="545" height="219.5" as="geometry"/>
        </mxCell>
        <mxCell id="b-note" value="Three things to take from this one&lt;br&gt;&lt;br&gt;* rule ids come from the SESSION, never from constants.&lt;br&gt;&amp;nbsp;&amp;nbsp;spec.qer(id) raises when absent, so a preset renumbering&lt;br&gt;&amp;nbsp;&amp;nbsp;is an immediate error rather than a request that quietly&lt;br&gt;&amp;nbsp;&amp;nbsp;removes nothing.&lt;br&gt;* mark() sits immediately before the modify(), so the count&lt;br&gt;&amp;nbsp;&amp;nbsp;belongs to that one request. In arrange() it would also&lt;br&gt;&amp;nbsp;&amp;nbsp;have caught the establishment.&lt;br&gt;* self.logs, not self.ctx.logs. stable_pipeline_rebuilds_&lt;br&gt;&amp;nbsp;&amp;nbsp;since is an OaiLogs extra, and OaiScenario narrows the&lt;br&gt;&amp;nbsp;&amp;nbsp;type so it is in scope -- see upf_test/scenarios/base.py." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="943.0" width="545" height="204.0" as="geometry"/>
        </mxCell>
        <mxCell id="b-out" value="$ ./run_scenarios.py --scenario rebuild_once&lt;br&gt;&lt;br&gt;== rebuild_once: FAIL ==&lt;br&gt;&amp;nbsp;&amp;nbsp;[PASS ] session establishment accepted&lt;br&gt;&amp;nbsp;&amp;nbsp;[PASS ] modification accepted&lt;br&gt;&amp;nbsp;&amp;nbsp;[FAIL ] datapath rebuilt exactly once for the whole&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;modification&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; expected 1 occurrence(s), counted 25&lt;br&gt;&amp;nbsp;&amp;nbsp;[WARN ] 25 rebuilds for 4 removal IE(s) -- the ratio&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;shows whether the datapath is rebuilt once per&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;IE or something is multiplying faster than that&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;2 passed, 1 failed, 1 warning(s)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#1f2430;strokeColor=#3d4451;fontColor=#e6e6e6;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1161.0" width="545" height="204.0" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lc-execute" target="lc-hooks">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lc-hooks" target="lc-helpers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lc-helpers" target="lc-report">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a-arrange" target="a-act">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a-act" target="a-verify">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b-arrange" target="b-act">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="3-Readingascenario-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b-act" target="b-verify">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3-doc" value="Every scenario opens with the same three headings -- and they are the contract, not decoration&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;&quot;&quot;Change a QER's GBR/MBR and check the new rates are enforced.&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;**Scenario.**&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;what the test does: the PFCP sequence, and why any non-obvious step is there&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;**Expected behaviour.** what a CORRECT UPF does, cited to TS 29.244 where the spec settles it&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;**Expected output.**&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;how many checks pass, and what any warning means&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;&quot;&quot;&lt;br&gt;&lt;br&gt;Read the third heading first when a run surprises you: it tells you what the scenario itself considers a pass, so you can&lt;br&gt;tell &quot;the UPF is wrong&quot; from &quot;I am reading the wrong scenario&quot;.&lt;br&gt;&lt;br&gt;Note what is NOT there: no bug number, no fix reference, no source-file citation. A scenario states a requirement, so it&lt;br&gt;stays correct after the defect is fixed and simply starts passing. The defect-to-scenario map lives in&lt;br&gt;.vscode/pfcp_modification_qos_fixes.md and points AT the tests; a Coverage index at its end gives the reverse lookup." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1538.0" width="1555" height="250.5" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4 - Extending">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="4-Extending-1" value="Extending the suite - two paths" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="1340" height="49.0" as="geometry"/>
        </mxCell>
        <mxCell id="4-Extending-2" value="Left: add a scenario for the OAI UPF.&amp;nbsp;&amp;nbsp;&amp;nbsp;Right: test a different UPF.&amp;nbsp;&amp;nbsp;&amp;nbsp;The library itself only changes for a genuinely new PFCP IE." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1340" height="35.05" as="geometry"/>
        </mxCell>
        <mxCell id="4-Extending-3" value="A.&amp;nbsp;&amp;nbsp;&amp;nbsp;Add a scenario for the OAI UPF" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#4a7a3a;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="620" height="39.7" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="1.&amp;nbsp;&amp;nbsp;Create upf_test/scenarios/NN-topic.py&lt;br&gt;&lt;br&gt;The number is the RUN ORDER, not a label. Insert before 16-repeated_modification.py,&lt;br&gt;which must stay last because it can leave the UPF degraded." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="118" width="620" height="80.0" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="2.&amp;nbsp;&amp;nbsp;Write the class - ONE registered class per file&lt;br&gt;&lt;br&gt;@register&lt;br&gt;class MyCase(OaiScenario):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;name&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= &quot;my_case&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;description = &quot;What correct behaviour is&quot;&amp;nbsp;&amp;nbsp;&amp;nbsp;# a requirement, present tense&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;tags&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= frozenset({&quot;datapath&quot;})&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;requires&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= frozenset({Capability.LOG_WINDOW})&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ue_index&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= 23&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# MUST be unique&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def act(self) -&amp;gt; None: ...&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def verify(self) -&amp;gt; None: ..." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="212.0" width="620" height="204.0" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="3.&amp;nbsp;&amp;nbsp;Open with a Scenario / Expected behaviour / Expected output docstring&lt;br&gt;&lt;br&gt;Say what the UPF should do and what a passing run prints." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="430.0" width="620" height="95.5" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="4.&amp;nbsp;&amp;nbsp;Nothing else. Discovery picks it up.&lt;br&gt;&lt;br&gt;$ ./run_scenarios.py --list&lt;br&gt;$ ./run_scenarios.py --scenario my_case -v&lt;br&gt;$ .venv/bin/python -m pytest -m integration -k my_case&lt;br&gt;&lt;br&gt;No import list, no runner edit, no pytest registration." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#1f2430;strokeColor=#3d4451;fontColor=#e6e6e6;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="539.5" width="620" height="126.5" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="The three mistakes the conventions test catches for you&lt;br&gt;unit/test_scenario_conventions.py - each of these once cost real debugging time&lt;br&gt;&lt;br&gt;* a duplicate ue_index -&amp;gt; two scenarios share a UE IP. Because this UPF never clears its&lt;br&gt;&amp;nbsp;&amp;nbsp;UE-address state on deletion, the FIRST scenario's leftovers become the SECOND one's&lt;br&gt;&amp;nbsp;&amp;nbsp;failure, and it reads as a bug in the second.&lt;br&gt;* an un-numbered or duplicate NN prefix -&amp;gt; undefined run order&lt;br&gt;* reading self.rules / self.qos / self.logs without declaring the capability" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="680.0" width="620" height="142.0" as="geometry"/>
        </mxCell>
        <mxCell id="a6" value="Before asserting something was REMOVED, assert it was there&lt;br&gt;&lt;br&gt;self.require_pdrs_installed(seid, ids)&lt;br&gt;&lt;br&gt;Removing a rule that was never installed is a no-op, so &quot;it is absent afterwards&quot; would&lt;br&gt;pass while testing nothing. Same reason rule ids come from spec.qer(id) rather than from&lt;br&gt;a preset constant." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="836.0" width="620" height="126.5" as="geometry"/>
        </mxCell>
        <mxCell id="4-Extending-4" value="B.&amp;nbsp;&amp;nbsp;&amp;nbsp;Test a different UPF" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#8a5a00;" vertex="1" parent="1">
          <mxGeometry x="690" y="90" width="620" height="39.7" as="geometry"/>
        </mxCell>
        <mxCell id="b0" value="Everything in pfcpkit applies unchanged. Start from pfcpkit/README.md; pfcpkit/examples/ is&lt;br&gt;a runnable worked version - adapter, base class and three scenarios, no UPF needed." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="118" width="620" height="49.0" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="1.&amp;nbsp;&amp;nbsp;An adapter - implement what your UPF can serve&lt;br&gt;&lt;br&gt;CAPABILITIES = frozenset({Capability.RULE_STATE})&lt;br&gt;ADAPTER_NAME = &quot;my-upf&quot;&lt;br&gt;&lt;br&gt;class MyRuleState:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# no base class: Protocols are structural&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def installed_pdr_ids(self, seid: int) -&amp;gt; list[int]:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return sorted(self._client.get(f&quot;/sessions/{seid}/pdrs&quot;))&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def installed_qfis(self, seid): ...&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def seid_for_ue_ip(self, ue_ipv4): ...&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def session_installed(self, seid): ..." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="181.0" width="620" height="188.5" as="geometry"/>
        </mxCell>
        <mxCell id="b1n" value="It does NOT have to be eBPF. A UPF with a REST endpoint implements installed_pdr_ids with&lt;br&gt;an HTTP call and every scenario reads unchanged. Declare only what you actually implement:&lt;br&gt;over-claiming turns a clean skip into a confusing mid-run failure." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="383.5" width="620" height="64.5" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="2.&amp;nbsp;&amp;nbsp;A harness - the only place a context is built&lt;br&gt;&lt;br&gt;@contextmanager&lt;br&gt;def build_context(settings=None):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;add_discovery_root(&quot;my_upf_test.scenarios&quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;with PfcpClient(settings) as client:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;yield ScenarioContext(settings=settings, client=client,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rules=MyRuleState(...), qos=..., logs=...,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;capabilities=CAPABILITIES, adapter=ADAPTER_NAME)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="462.0" width="620" height="157.5" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="3.&amp;nbsp;&amp;nbsp;Scenarios - copy upf_test/scenarios/ and work through them&lt;br&gt;&lt;br&gt;Most bodies survive untouched: the PFCP side is the same protocol, and state assertions go&lt;br&gt;through the capability protocols. What needs attention is the small set a different data&lt;br&gt;path expresses differently - the log-pattern ones (12, 13, 14, 16) and anything reading an&lt;br&gt;adapter extra. Drop what does not apply; rewrite the verifiers for what does." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="633.5" width="620" height="111.0" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="If a scenario needs an adapter EXTRA&lt;br&gt;&lt;br&gt;self.ctx.logs.rebuilds_since(mark, seid)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; error: &quot;LogSource&quot; has no attribute &quot;rebuilds_since&quot;&lt;br&gt;&lt;br&gt;The error is correct: the protocol has no such method, the object does. Give yourself a&lt;br&gt;base class that re-exposes the fields under your concrete types, in ONE place:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;class MyScenario(PfcpScenario):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;@property&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def logs(self) -&amp;gt; MyLogSource:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return cast(MyLogSource, self.ctx.logs)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="758.5" width="620" height="204.0" as="geometry"/>
        </mxCell>
        <mxCell id="footer" value="Verifying a change to the suite itself&lt;br&gt;&lt;br&gt;$ .venv/bin/python -m pytest unit -q&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# 220 cases, no UPF and no root needed&lt;br&gt;$ .venv/bin/python -m pytest unit/library -q&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# library only - must pass with NO adapter importable&lt;br&gt;$ .venv/bin/ruff check .&lt;br&gt;$ .venv/bin/mypy pfcpkit upf_test run_scenarios.py conftest.py test_scenarios.py conf&lt;br&gt;$ docker compose -f docker-compose.yaml restart upf&amp;nbsp;&amp;nbsp;# ALWAYS, before comparing numbers between runs&lt;br&gt;$ ./run_scenarios.py --tag smoke&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# must exit 0 - the harness itself is healthy&lt;br&gt;$ ./run_scenarios.py --all&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# exits 1: 22 failing checks across 12 of 16 scenarios" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#1f2430;strokeColor=#3d4451;fontColor=#e6e6e6;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="982.5" width="1270" height="157.5" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5 - Module reference">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="5-Modulereference-1" value="Module reference - what lives where, and what each piece exposes" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="1340" height="49.0" as="geometry"/>
        </mxCell>
        <mxCell id="5-Modulereference-2" value="The detail behind page 1. Nothing here is needed to read or write a scenario; it is for finding the file you want.&lt;br&gt;Layering runs top to bottom within each column, and dependencies only ever point downward and leftward." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1340" height="52.1" as="geometry"/>
        </mxCell>
        <mxCell id="5-Modulereference-3" value="pfcpkit/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the library.&amp;nbsp;&amp;nbsp;Ships NO scenarios." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#31486b;" vertex="1" parent="1">
          <mxGeometry x="40" y="104" width="700" height="39.7" as="geometry"/>
        </mxCell>
        <mxCell id="5-Modulereference-4" value="Protocol layer - the only place scapy and sockets appear" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#31486b;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="700" height="35.05" as="geometry"/>
        </mxCell>
        <mxCell id="p1-proto" value="pfcp/client.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;PfcpClient - the facade scenarios use&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;establish_session(spec) / modify_session(session, delta) / delete_session(session)&lt;br&gt;pfcp/transport.py&amp;nbsp;&amp;nbsp;socket, sequence correlation, retries, heartbeat responder&lt;br&gt;pfcp/codec.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;spec dataclass &amp;lt;-&amp;gt; scapy IE tree.&amp;nbsp;&amp;nbsp;A scapy upgrade is a one-file problem." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#b1d0f0;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="162" width="700" height="80.0" as="geometry"/>
        </mxCell>
        <mxCell id="5-Modulereference-5" value="Describing intent - frozen dataclasses, no wire format" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#31486b;" vertex="1" parent="1">
          <mxGeometry x="40" y="260.0" width="700" height="35.05" as="geometry"/>
        </mxCell>
        <mxCell id="p1-models" value="models.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;PdrSpec&amp;nbsp;&amp;nbsp;FarSpec&amp;nbsp;&amp;nbsp;QerSpec&amp;nbsp;&amp;nbsp;SessionSpec&amp;nbsp;&amp;nbsp;ModificationSpec&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;spec.qer(id) and spec.pdrs_for_qer(id) RAISE when absent, so a stale&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rule id is an immediate error rather than a request that removes nothing&lt;br&gt;presets.py&amp;nbsp;&amp;nbsp;&amp;nbsp;basic_ipv4_session(...)&amp;nbsp;&amp;nbsp;multi_flow_session(...)&amp;nbsp;&amp;nbsp;gbr_qer(...)&amp;nbsp;&amp;nbsp;ue_ipv4(settings, index)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="282.0" width="700" height="80.0" as="geometry"/>
        </mxCell>
        <mxCell id="5-Modulereference-6" value="Scenario framework - the extension point" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#31486b;" vertex="1" parent="1">
          <mxGeometry x="40" y="380.0" width="700" height="35.05" as="geometry"/>
        </mxCell>
        <mxCell id="p1-base" value="scenarios/base.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;PfcpScenario (ABC)&amp;nbsp;&amp;nbsp;&amp;lt;- what you subclass&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;arrange()&amp;nbsp;&amp;nbsp;act()&amp;nbsp;&amp;nbsp;verify()&amp;nbsp;&amp;nbsp;teardown()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;execute() - fixed skeleton, always tears down, never raises&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;establish / modify / delete / ue_ip / require_pdrs_installed" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#b1d0f0;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="402.0" width="700" height="80.0" as="geometry"/>
        </mxCell>
        <mxCell id="p1-registry" value="scenarios/__init__.py&amp;nbsp;&amp;nbsp;register(cls)&amp;nbsp;&amp;nbsp;&amp;nbsp;@decorator&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;add_discovery_root(pkg) / discover() / select(names=, tags=)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;partition_by_capability(...) -&amp;gt; (runnable, [(scenario, missing)])&lt;br&gt;scenarios/context.py&amp;nbsp;&amp;nbsp;&amp;nbsp;ScenarioContext - settings, client, and the three state fields" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="496.0" width="700" height="80.0" as="geometry"/>
        </mxCell>
        <mxCell id="p1-caps" value="capabilities.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;THE SEAM&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Capability:&amp;nbsp;&amp;nbsp;RULE_STATE&amp;nbsp;&amp;nbsp;&amp;nbsp;QOS_STATE&amp;nbsp;&amp;nbsp;&amp;nbsp;LOG_WINDOW&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Protocols:&amp;nbsp;&amp;nbsp;&amp;nbsp;RuleState&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;QosState&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;LogSource&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Structural - no base class to inherit. Semantic, not storage-shaped:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;installed_pdr_ids(seid), never get_map_entries()." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="590.0" width="700" height="95.5" as="geometry"/>
        </mxCell>
        <mxCell id="5-Modulereference-7" value="Generic mechanics - used by an adapter, no UPF knowledge inside" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#31486b;" vertex="1" parent="1">
          <mxGeometry x="40" y="703.5" width="700" height="35.05" as="geometry"/>
        </mxCell>
        <mxCell id="p1-inspect" value="inspect/runner.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;CommandRunner - the ONLY subprocess use in the tree&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;LocalRunner&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;DockerExecRunner(container)&lt;br&gt;inspect/bpftool.py&amp;nbsp;&amp;nbsp;&amp;nbsp;BpfMapInspector(runner, catalogue) - catalogue is INJECTED&lt;br&gt;inspect/tc.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;TcInspector - parses classes and qdiscs, text and JSON&lt;br&gt;inspect/logs.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;LogInspector - mark() / count_since() / stable_count_since()&lt;br&gt;inspect/layouts.py&amp;nbsp;&amp;nbsp;&amp;nbsp;StructLayout, MapSpec, the kernel's 15-char name truncation" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="725.5" width="700" height="111.0" as="geometry"/>
        </mxCell>
        <mxCell id="p1-support" value="report.py&amp;nbsp;&amp;nbsp;&amp;nbsp;Check / TestReport / SuiteReport - soft checks, so one failure hides nothing&lt;br&gt;config.py&amp;nbsp;&amp;nbsp;&amp;nbsp;Settings.from_env() - PFCP addressing and timing only&lt;br&gt;errors.py&amp;nbsp;&amp;nbsp;&amp;nbsp;the exception hierarchy&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;waiting.py&amp;nbsp;&amp;nbsp;wait_until(predicate, timeout=)&lt;br&gt;examples/&amp;nbsp;&amp;nbsp;&amp;nbsp;a runnable worked example, plus README.md - the authoring guide" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="850.5" width="700" height="80.0" as="geometry"/>
        </mxCell>
        <mxCell id="p1-libnote" value="No UPF knowledge anywhere above. No map names, no log strings, no class-id arithmetic,&lt;br&gt;no container names. That is what lets another project take this directory unchanged, and&lt;br&gt;what unit/library/ proves by passing with no adapter importable." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="944.5" width="700" height="64.5" as="geometry"/>
        </mxCell>
        <mxCell id="5-Modulereference-8" value="upf_test/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the OAI adapter + every scenario" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#8a5a00;" vertex="1" parent="1">
          <mxGeometry x="790" y="104" width="520" height="39.7" as="geometry"/>
        </mxCell>
        <mxCell id="p1-inspector" value="inspector.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;implements the protocols&lt;br&gt;&lt;br&gt;OaiRuleState -&amp;gt; RuleState&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;OaiQosState -&amp;gt; QosState&lt;br&gt;CAPABILITIES = {RULE_STATE, QOS_STATE, LOG_WINDOW}&lt;br&gt;ADAPTER_NAME = &quot;oai-upf&quot;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffcc99;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="140" width="520" height="95.5" as="geometry"/>
        </mxCell>
        <mxCell id="p1-oailogs" value="logs.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;OaiLogs -&amp;gt; LogSource&lt;br&gt;&lt;br&gt;Delegates the windowing, adds this UPF's strings:&lt;br&gt;&amp;nbsp;&amp;nbsp;pipeline_rebuilds_since / stable_pipeline_rebuilds_since&lt;br&gt;&amp;nbsp;&amp;nbsp;tc_failures_since / attach_refusals_since / qos_setups_since" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="249.5" width="520" height="95.5" as="geometry"/>
        </mxCell>
        <mxCell id="p1-layouts" value="layouts.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the BPF map catalogue&lt;br&gt;&lt;br&gt;MAPS = { &quot;rules_match_pdr_map&quot;: MapSpec(...), ... }&lt;br&gt;PDRS_PER_SESSION = StructLayout(&quot;&amp;lt;H6xQ&quot;, (&quot;pdr_id&quot;, &quot;seid&quot;))&lt;br&gt;&amp;nbsp;&amp;nbsp;{u16 pdr_id; u64 seid} is 16 bytes, not 10 - six of padding." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="359.0" width="520" height="95.5" as="geometry"/>
        </mxCell>
        <mxCell id="p1-classids" value="class_ids.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;HTB class-id arithmetic&lt;br&gt;&lt;br&gt;session_class_minor(seid) = seid &amp;amp; 0xFFFF&lt;br&gt;qos_class_minor(seid, qfi) mirrors generate_minor_id()&lt;br&gt;A pure hash, no counter. Derived, never discovered." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="468.5" width="520" height="95.5" as="geometry"/>
        </mxCell>
        <mxCell id="p1-harness" value="harness.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the ONLY place a context is built&lt;br&gt;&lt;br&gt;build_context() wires:&lt;br&gt;&amp;nbsp;&amp;nbsp;DockerExecRunner -&amp;gt; bpftool + tc&amp;nbsp;&amp;nbsp;&amp;nbsp;(inside the container)&lt;br&gt;&amp;nbsp;&amp;nbsp;LocalRunner&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; docker logs&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(on the host)&lt;br&gt;and calls add_discovery_root(&quot;upf_test.scenarios&quot;)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffcc99;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="578.0" width="520" height="111.0" as="geometry"/>
        </mxCell>
        <mxCell id="p1-scenarios" value="scenarios/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;all 16, one registered class per file&lt;br&gt;&lt;br&gt;base.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;OaiScenario - narrows ctx to the concrete adapters&lt;br&gt;01-establishment.py&amp;nbsp;&amp;nbsp;..&amp;nbsp;&amp;nbsp;16-repeated_modification.py&lt;br&gt;&lt;br&gt;NN- is the RUN ORDER: discovery walks sorted, so 16 runs last&lt;br&gt;because it can leave the UPF degraded." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="703.0" width="520" height="126.5" as="geometry"/>
        </mxCell>
        <mxCell id="p1-settings" value="settings.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Deployment.from_env()&lt;br&gt;&lt;br&gt;UPF_CONTAINER&amp;nbsp;&amp;nbsp;&amp;nbsp;N3_IFACE&amp;nbsp;&amp;nbsp;&amp;nbsp;N6_IFACE&amp;nbsp;&amp;nbsp;&amp;nbsp;BPFTOOL&amp;nbsp;&amp;nbsp;&amp;nbsp;COMMAND_TIMEOUT&lt;br&gt;&lt;br&gt;Separate from pfcpkit's Settings on purpose: that holds PFCP&lt;br&gt;addressing, this holds how the UPF is deployed and observed.&lt;br&gt;A UPF behind an HTTP API would need none of it." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="843.5" width="520" height="126.5" as="geometry"/>
        </mxCell>
        <mxCell id="p1-rule" value="The one rule the type system cannot express, so a test does&lt;br&gt;&lt;br&gt;unit/test_boundary.py parses every pfcpkit module and fails on an upf_test import, or on a @register&lt;br&gt;appearing in the library at all. It is checked by parsing rather than by importing, so an import buried&lt;br&gt;in a rarely-taken branch is caught too - and it is the only mechanical proof the library is standalone." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1029.0" width="1270" height="95.5" as="geometry"/>
        </mxCell>
        <mxCell id="5-Modulereference-9" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;strokeWidth=2;exitX=0;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="p1-inspector" target="p1-caps">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="5-Modulereference-10" value="subclass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="p1-scenarios" target="p1-base">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="5-Modulereference-11" value="injects runners + catalogue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=0;exitY=0.6;entryX=1;entryY=0.3;" edge="1" parent="1" source="p1-harness" target="p1-inspect">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
