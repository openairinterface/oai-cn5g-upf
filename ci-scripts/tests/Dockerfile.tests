# SPDX-License-Identifier: MIT
#
# Optional containerised test runner. The host path is the default; use this when
# installing scapy on a CI agent is undesirable.
#
# Needs the Docker CLI (not the daemon) because datapath inspection runs
# bpftool/tc inside the UPF container via `docker exec`.

FROM python:3.12-slim

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
        docker.io \
        iproute2 \
        git \
        openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tests

# Only the manifest, not the source, so editing a scenario doesn't invalidate this
# layer -- the source is bind-mounted at run time anyway (see below). Building
# oai-upf-tests itself here is a no-op (no source yet); only its declared
# dependencies -- scapy, pfcpkit, PyYAML -- actually get installed.
COPY pyproject.toml ./
RUN pip install --no-cache-dir ".[oai]"

# Source is bind-mounted at run time so edits need no rebuild.
ENTRYPOINT ["python3", "run_scenarios.py"]
CMD ["--all"]
