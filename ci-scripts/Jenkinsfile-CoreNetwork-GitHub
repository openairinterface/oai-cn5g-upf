import groovy.transform.Field

@Field def ubuntuBuildResource                  // Ubuntu build lock
@Field def armBuildResource                     // ARM build lock
@Field def rhelNode                             // RHEL build node
@Field def rhelResource                         // RHEL build lock
@Field def rhelOcCredentials                    // OpenShift login creds
@Field def server                               // OpenShift server URL
@Field def EpelPackage                          // EPEL package URL
@Field def cppcheckNode                         // cppcheck node
@Field def cppcheckResource                     // cppcheck lock
@Field def formatCheckNode                      // clang-format node
@Field def formatCheckResource                  // clang-format lock
@Field def PrivateRegistryURL                   // internal registry URL
@Field def runTrivyScan                         // enable Trivy scan
@Field def Namespace                            // OpenShift namespace
@Field def buildRhel                            // enable RHEL build
@Field def buildLttng                           // enable LTTNG build
@Field def commonSrcPath                        // common source path
@Field def claHost                              // host holding the CLA signatory list
@Field def claFile                              // CLA signatory list, path on claHost
@Field def DH_Account                           // Docker Hub account
@Field def dockerHubCredentialsId               // Docker Hub login creds
@Field def privateRegistryCredentialsId         // private registry login creds

@Field def cppcheckDockerfile       = 'ci-scripts/common/docker/Dockerfile.ci.cppcheck'      // cppcheck Dockerfile
@Field def clangFormatDockerfile    = 'ci-scripts/common/docker/Dockerfile.ci.clang-format'  // clang-format Dockerfile
@Field def cppcheckDockerfileTmp    = 'Dockerfile.cppcheck.tmp'      // generated cppcheck Dockerfile
@Field def clangFormatDockerfileTmp = 'Dockerfile.clang-format.tmp'  // generated clang-format Dockerfile
@Field def githubCredentialsId   = 'github-jenkins-oai-cn'   // GitHub checkout creds
@Field def nf                              // NF name, lowercase
@Field def NF                              // NF name, uppercase
@Field def isPullRequest = false   // true if triggered by a PR
@Field def nf_tag        = 'develop'  // image tag, set later
@Field def nf_branch     = ''      // source branch
@Field def targetBranch  = ''      // PR target branch
@Field def shortenShaOne = ''      // short commit SHA
@Field def failingStages = ''      // markdown bullet list of stages that failed, for the PR comment
@Field def mrValidationWarning = '' // Signed-off-by/merge-commit guideline message, for the PR comment
@Field def preBuildFailureMessage = '' // pre-build stage failure note for the PR comment
@Field def downstreamUrls = [:]    // stage name -> downstream test job build URL, for its GitHub check link

// Per-NF behaviour matrix
@Field def nfConfig = [
  ausf: [display: 'AUSF', hasLttng: true,  hasUnitTests: false, hasSanityCheck: false, hasTutorialsTest: true,  hasCotsUeTest: true,  hasLoadTest: false, hasEbpfTutorialsTest: false, hasRobotTest: true,  hasRobotNorthBoundTest: false],
  amf:  [display: 'AMF',  hasLttng: true,  hasUnitTests: true,  hasSanityCheck: false, hasTutorialsTest: true,  hasCotsUeTest: true,  hasLoadTest: true,  hasEbpfTutorialsTest: false, hasRobotTest: true, hasRobotNorthBoundTest: true],
  smf:  [display: 'SMF',  hasLttng: true,  hasUnitTests: true,  hasSanityCheck: false, hasTutorialsTest: true,  hasCotsUeTest: true,  hasLoadTest: true,  hasEbpfTutorialsTest: false, hasRobotTest: true,  hasRobotNorthBoundTest: true ],
  upf:  [display: 'UPF',  hasLttng: true,  hasUnitTests: false, hasSanityCheck: false, hasTutorialsTest: true,  hasCotsUeTest: true,  hasLoadTest: true,  hasEbpfTutorialsTest: true,  hasRobotTest: true,  hasRobotNorthBoundTest: false],
  udm:  [display: 'UDM',  hasLttng: false, hasUnitTests: false, hasSanityCheck: false, hasTutorialsTest: true,  hasCotsUeTest: true,  hasLoadTest: false, hasEbpfTutorialsTest: false, hasRobotTest: true,  hasRobotNorthBoundTest: false],
  udr:  [display: 'UDR',  hasLttng: false, hasUnitTests: false, hasSanityCheck: false, hasTutorialsTest: true,  hasCotsUeTest: true,  hasLoadTest: false, hasEbpfTutorialsTest: false, hasRobotTest: true,  hasRobotNorthBoundTest: false],
  nrf:  [display: 'NRF',  hasLttng: true,  hasUnitTests: false, hasSanityCheck: false, hasTutorialsTest: true,  hasCotsUeTest: true,  hasLoadTest: true,  hasEbpfTutorialsTest: false, hasRobotTest: true,  hasRobotNorthBoundTest: false],
  pcf:  [display: 'PCF',  hasLttng: true,  hasUnitTests: false, hasSanityCheck: false, hasTutorialsTest: true,  hasCotsUeTest: false, hasLoadTest: false, hasEbpfTutorialsTest: false, hasRobotTest: true,  hasRobotNorthBoundTest: false],
  nssf: [display: 'NSSF', hasLttng: false, hasUnitTests: false, hasSanityCheck: false, hasTutorialsTest: true,  hasCotsUeTest: false, hasLoadTest: false, hasEbpfTutorialsTest: false, hasRobotTest: false, hasRobotNorthBoundTest: false],
  lmf:  [display: 'LMF',  hasLttng: false, hasUnitTests: false, hasSanityCheck: true,  hasTutorialsTest: false, hasCotsUeTest: false, hasLoadTest: false, hasEbpfTutorialsTest: false, hasRobotTest: false, hasRobotNorthBoundTest: false],
]
@Field def cfg

//-------------------------------------------------------------------------------
pipeline {
  agent {
    label params.UbuntuBuildNode
  }
  options {
    disableConcurrentBuilds()
    timestamps()
    ansiColor('xterm')
  }

  stages {
    // Load + validate job params; fail on unknown NF or RHEL build without OpenShift creds.
    stage('Initialize Pipeline Configuration') {
      steps {
        script {
          nf = (params.coreNetworkFunction ?: '').toLowerCase()
          NF = nf.toUpperCase()

          // Detect PR early so pre-build stage failures still post a PR comment.
          isPullRequest = !!env.GITHUB_PR_NUMBER?.trim()

          ubuntuBuildResource = params.UbuntuBuildResource
          armBuildResource    = params.armBuildResource
          rhelNode            = params.RhelBuildNode
          rhelResource        = params.RhelBuildResource
          rhelOcCredentials   = params.RhelOcCredentials
          server              = params.openshiftServer
          EpelPackage         = params.EpelPackageUrl
          cppcheckNode        = params.CppCheckNode
          cppcheckResource    = params.CppCheckResource
          formatCheckNode     = params.FormatCheckNode
          formatCheckResource = params.FormatCheckResource
          PrivateRegistryURL  = params.privateDockerRegistry
          runTrivyScan        = params.runTrivyScan
          Namespace           = params.openshiftNamespace ?: 'oaicicd-core'

          buildRhel     = (params.buildRhel  != null) ? params.buildRhel  : true
          buildLttng    = (params.buildLttng != null) ? params.buildLttng : true
          commonSrcPath = params.commonSrcPath ?: 'src/common-src'
          claHost       = params.claHost
          claFile       = params.claFile

          DH_Account            = params.dockerHubAccount
          dockerHubCredentialsId = params.DockerHubCredentials
          privateRegistryCredentialsId = params.PrivateRegistryCredentials

          echo "Pipeline configuration loaded for ${NF}"

          if (!nfConfig.containsKey(nf)) {
            error "Unknown or missing coreNetworkFunction parameter: '${params.coreNetworkFunction}'"
          }
          cfg = nfConfig[nf]

          if (buildRhel && params.RhelOcCredentials == null) {
            echo 'No Credentials to connect to Openshift!'
            error "Stopping pipeline!"
          }

          if (params.PrivateRegistryCredentials == null) {
            error "No credentials to log in to the private docker registry!"
          }

          env.JOB_TIMESTAMP = sh(returnStdout: true, script: 'date --utc --rfc-3339=seconds | sed -e "s#+00:00##"').trim()
        }
      }
      post {
        failure {
          script {
            preBuildFailureMessage = "Invalid or missing parameters, or internal CI error"
            echo preBuildFailureMessage
            recordFailure()
          }
        }
      }
    }

    // Derive PR-vs-push, branch, SHA, and image tag for later stages, then check out source.
    stage('Prepare Source Metadata') {
      steps {
        lock(ubuntuBuildResource) {
          script {
            def gitLocalBranch = env.GIT_BRANCH ? env.GIT_BRANCH.replace('origin/', '') : ''
            isPullRequest = !!env.GITHUB_PR_NUMBER?.trim()
            echo "Preparing build Metadata for Network Function:   ${NF}"

            if (isPullRequest) {
              def prHeadSha = env.GITHUB_PR_HEAD_SHA
              if (!prHeadSha) {
                error "GITHUB_PR_HEAD_SHA is missing -- cannot identify the commit to build for PR #${env.GITHUB_PR_NUMBER}"
              }
              nf_branch     = env.GITHUB_PR_SOURCE_BRANCH
              targetBranch  = env.GITHUB_PR_TARGET_BRANCH
              shortenShaOne = prHeadSha.take(8)
              nf_tag        = "${nf_branch.replace('/', '-').replace('+', '-')}-${prHeadSha}"

              echo "PR number           :   ${env.GITHUB_PR_NUMBER}"
              echo "Source Repository   :   ${env.GITHUB_PR_URL}"
              echo "Source Branch       :   ${nf_branch}"
              echo "Commit ID           :   ${prHeadSha}"
              echo "Target Repo         :   ${env.GIT_URL}"
              echo "Target Branch       :   ${targetBranch}"
              echo "Label               :   ${env.GITHUB_PR_LABELS}"
              echo "Tag                 :   ${nf_tag}"

            } else {
              if (!env.GIT_COMMIT) {
                error "GIT_COMMIT is missing -- cannot identify the commit to build for branch '${gitLocalBranch}'"
              }
              nf_branch     = gitLocalBranch
              shortenShaOne = env.GIT_COMMIT.take(8)
              nf_tag        = "${gitLocalBranch}-${shortenShaOne}"

              echo "Branch              :   ${gitLocalBranch}"
              echo "Commit ID           :   ${env.GIT_COMMIT}"
              echo "Tag                 :   ${nf_tag}"
            }

            prepareWorkspace()
          }
        }
      }
      post {
        failure {
          script {
            preBuildFailureMessage = "Git operation failure or internal CI error"
            if (isPullRequest)
               preBuildFailureMessage += ", likely conflicts with ${targetBranch}; please resolve it."
            echo preBuildFailureMessage
            recordFailure()
          }
        }
      }
    }

    stage('Verify Guidelines') {
      when {
        expression { return isPullRequest }
      }
      steps {
        script {
          withCredentials([
            [$class: 'UsernamePasswordMultiBinding', credentialsId: githubCredentialsId, usernameVariable: 'GITHUB_USERNAME', passwordVariable: 'GITHUB_TOKEN']
          ]) {
            sh "git -c credential.helper='!f() { echo \"username=\$GITHUB_USERNAME\"; echo \"password=\$GITHUB_TOKEN\"; }; f' fetch --no-tags ${env.GIT_URL} +refs/heads/${targetBranch}:refs/remotes/origin/${targetBranch}"
          }
          // The list is kept on claHost: read it over SSH for the
          // check instead of storing a copy on the build node. Retry
          // to handle transient network failures.
          retry(3) {
            sh "ssh -o BatchMode=yes ${claHost} 'cat ${claFile}' > cla.csv"
          }
          // An empty list is a misconfiguration, not a reason to fail the CLA Check
          sh "test -s cla.csv"

          def mrValidationLog = "archives/signedCommit_${env.BUILD_NUMBER}.log"
          def mrValidationExitCode = sh(
            script: "bash ./ci-scripts/common/bash/pre-ci-check.sh -s ${env.GITHUB_PR_HEAD_SHA} -t origin/${targetBranch} -r ${params.gitAccount}/${params.gitRepo} -p ${env.GITHUB_PR_NUMBER} -c cla.csv > ${mrValidationLog} 2>&1",
            returnStatus: true
          )
          def mrValidationMessage = readFile(mrValidationLog).trim()
          if (mrValidationExitCode >= 1) {
            mrValidationWarning = mrValidationMessage
          }
          if (mrValidationExitCode >= 2) {
            error("${mrValidationMessage}")
          }
        }
      }
      post {
        cleanup {
          script {
            sh "rm -f cla.csv"
          }
        }
        failure {
          script {
            if (mrValidationWarning) {
              echo "Guideline verification failed for ${NF}: ${mrValidationWarning}"
            } else {
              preBuildFailureMessage = "Git operation failure or internal CI error"
              echo preBuildFailureMessage
            }
            recordFailure()
          }
        }
      }
    }

    // Code checks first: so a formatting or cppcheck
    // failure is reported before the image builds start.
    stage('Code Checks') {
      parallel {
        stage('Static Code Analysis') {
          agent { label cppcheckNode }
          options { skipDefaultCheckout() }
          steps {
            lock(cppcheckResource) {
              script {
                runStaticCodeAnalysis()
              }
            }
          }
          post {
            success {
              script {
                notifyStageStatus('SUCCESS', 'Passed')
              }
              sh "echo 'Cppcheck Static Code Analysis for OAI-${NF} status is SUCCESS' >> archives/cppcheck_install.log"
            }
            failure {
              script {
                recordFailure(nfReportLink())
              }
              sh "echo 'Cppcheck Static Code Analysis for OAI-${NF} status is FAILURE' >> archives/cppcheck_install.log"
            }
            cleanup {
              script {
                stash allowEmpty: true, includes: 'archives/cppcheck*.*', name: 'cppcheckLogs'
                sh "docker rm -f ${nf}-ci-cppcheck || true; docker rmi ${nf}-cppcheck:test || true"
                sh "rm -f ${cppcheckDockerfileTmp}"
              }
            }
          }
        }

        stage('Code Formatting Checker') {
          agent { label formatCheckNode }
          options { skipDefaultCheckout() }
          steps {
            lock(formatCheckResource) {
              script {
                runCodeFormattingChecker()
              }
            }
          }
          post {
            success {
              script {
                notifyStageStatus('SUCCESS', 'Passed')
              }
              sh "echo 'Code Formatting Checker for OAI-${NF} status is SUCCESS' >> archives/clang_format_install.log"
            }
            failure {
              script {
                recordFailure(nfReportLink())
              }
              sh "echo 'Code Formatting Checker for OAI-${NF} status is FAILURE' >> archives/clang_format_install.log"
            }
            cleanup {
              script {
                stash allowEmpty: true, includes: 'src/oai_rules_result*.txt, archives/clang_format_install.log', name: 'formatCheckLogs'
                sh "docker rm -f ${nf}-ci-clang-format || true; docker rmi ${nf}-clang-format-check:test || true"
                sh "rm -f ${clangFormatDockerfileTmp}"
              }
            }
          }
        }
      }
      post {
        // Both checks run on their own agents. Restore their logs here rather
        // than in a later stage: a failure here skips everything downstream, and
        // the logs are exactly what explains that failure in the report.
        always {
          script {
            try { unstash 'cppcheckLogs' }
            catch (e) { echo "No 'cppcheckLogs' stash to restore" }
            try { unstash 'formatCheckLogs' }
            catch (e) { echo "No 'formatCheckLogs' stash to restore" }
          }
        }
      }
    }

    stage('Build Images') {
      parallel {
        stage('Ubuntu ARM Neoverse V2 (Grace) Image Builder') {
          steps {
            lock(resource: ubuntuBuildResource, extra: [[resource: armBuildResource]]) {
              script {
                buildUbuntuImage()
              }
            }
          }
          post {
            success {
              script {
                notifyStageStatus('SUCCESS', 'Passed')
              }
              sh "echo 'Ubuntu ARM Neoverse V2 (Grace) Image Builder for OAI-${NF} status is SUCCESS' >> archives/${nf}_ubuntu_image_build.log"
            }
            failure {
              script {
                recordFailure(nfReportLink())
              }
              sh "echo 'Ubuntu ARM Neoverse V2 (Grace) Image Builder for OAI-${NF} status is FAILURE' >> archives/${nf}_ubuntu_image_build.log"
            }
          }
        }

        stage('Ubuntu Image with LTTNG Builder') {
          when {
            expression { return buildLttng && cfg.hasLttng }
          }
          steps {
            sleep 30
            lock(ubuntuBuildResource) {
              script {
                sh "docker buildx build --target oai-${nf} --tag oai-${nf}:lttng-build --file docker/Dockerfile.${nf}.ubuntu --build-arg ENABLE_LTTNG=true . > archives/${nf}_ubuntu_lttng_image_build.log 2>&1"
                sh "docker image rm oai-${nf}:lttng-build || true"
                sh "docker image prune --force"
              }
            }
          }
          post {
            success {
              script {
                notifyStageStatus('SUCCESS', 'Passed')
              }
              sh "echo 'Ubuntu Image with LTTNG Builder for OAI-${NF} status is SUCCESS' >> archives/${nf}_ubuntu_lttng_image_build.log"
            }
            failure {
              script {
                recordFailure(nfReportLink())
              }
              sh "echo 'Ubuntu Image with LTTNG Builder for OAI-${NF} status is FAILURE' >> archives/${nf}_ubuntu_lttng_image_build.log"
            }
          }
        }

        stage('RHEL-Cluster-Image-Builder') {
          when {
            expression { return buildRhel }
          }
          agent { label rhelNode }
          options { skipDefaultCheckout() }
          steps {
            lock(rhelResource) {
              script {
                prepareWorkspace()
                withCredentials([
                  [$class: 'UsernamePasswordMultiBinding', credentialsId: "${rhelOcCredentials}", usernameVariable: 'OC_Username', passwordVariable: 'OC_Password']
                ]) {
                  sh "oc login -u \"\$OC_Username\" -p \"\$OC_Password\" --server=${server} --insecure-skip-tls-verify"
                }
                sh "oc project ${Namespace}"
                sh "oc delete istag oai-${nf}:${nf_tag} -n ${Namespace} || true"
                sh "./ci-scripts/common/python/recreate_entitlement.py"
                sh "oc delete -f openshift/build-config.yaml || true"
                sh "sed -i -e 's@oai-${nf}:latest@oai-${nf}:${nf_tag}@g' openshift/build-config.yaml"
                sh """
    sed -i '/^[[:space:]]*dockerfilePath:/a\\
            buildArgs:\\
              - name: EPEL_URL\\
                value: "${EpelPackage}"' openshift/build-config.yaml
    """
                sh "oc create -f openshift/build-config.yaml"
                sh "oc start-build ${nf}-build-cfg --from-dir=./ --exclude=''"
                sh "./ci-scripts/common/python/check_build_pod_status.py --pod-name ${nf}-build-cfg-1-build --log-file archives/${nf}_rhel_image_build.log"
                sh "oc describe istag oai-${nf}:${nf_tag} -n ${Namespace} | grep 'Image Size:' >> archives/${nf}_rhel_image_build.log"
              }
            }
          }
          post {
            success {
              script {
                notifyStageStatus('SUCCESS', 'Passed')
              }
              sh "echo 'RHEL-Cluster-Image-Builder for OAI-${NF} status is SUCCESS' >> archives/${nf}_rhel_image_build.log"
            }
            failure {
              script {
                recordFailure(nfReportLink())
              }
              sh "echo 'RHEL-Cluster-Image-Builder for OAI-${NF} status is FAILURE' >> archives/${nf}_rhel_image_build.log"
            }
            cleanup {
              script {
                sh "oc delete bc ${nf}-build-cfg -n ${Namespace} || true"
                sh "oc logout || true"
                stash allowEmpty: true, includes: "archives/${nf}_rhel_image_build.log", name: 'rhelBuildLog'
              }
            }
          }
        }

        stage('Build and Run Unit-Tests') {
          when {
            expression { return cfg.hasUnitTests }
          }
          steps {
            sleep 40
            lock(ubuntuBuildResource) {
              script {
                if (fileExists("${commonSrcPath}/build/common/Dockerfile.unit-tests.ubuntu")) {
                  sh "date --rfc-email > ${commonSrcPath}/date.txt"
                  sh "docker buildx build --target common-src-unit-tests --tag common-src-unit-tests:latest --file ${commonSrcPath}/build/common/Dockerfile.unit-tests.ubuntu ./${commonSrcPath}/ > archives/build-unit-tests.log 2>&1"
                } else {
                  echo "Skipping Unit Tests for OAI-${NF}: ${commonSrcPath}/build/common/Dockerfile.unit-tests.ubuntu not found -- unit-test Dockerfile not yet added for this NF's common-src checkout"
                }
              }
            }
          }
          post {
            success {
              script {
                notifyStageStatus('SUCCESS', 'Passed')
              }
            }
            failure {
              script {
                recordFailure()
              }
            }
            cleanup {
              script {
                sh "docker image rm common-src-unit-tests:latest || true"
              }
            }
          }
        }
      }
      post {
        // The RHEL image builds on its own agent. Restore its stashed log here so
        // the final report/zip step can include it; it exists only if that ran.
        always {
          script {
            if (buildRhel) {
              try { unstash 'rhelBuildLog' }
              catch (e) { echo "No 'rhelBuildLog' stash to restore" }
            }
          }
        }
      }
    }

    // Publish only on develop-branch pushes; PR/other pushes stay in the private registry.
    stage('Publish Image to Docker Hub') {
      when {
        expression { return !isPullRequest && nf_branch == 'develop' }
      }
      steps {
        lock(ubuntuBuildResource) {
          script {
            publishToDockerHub()
          }
        }
      }
      post {
        success {
          echo "Published ${DH_Account}/oai-${nf}:develop for OAI-${NF}"
        }
        failure {
          script {
            echo "Failed to publish OAI-${NF} image to Docker Hub"
            recordFailure()
          }
        }
      }
    }

    stage('Sanity Check on Ubuntu') {
      when {
        expression { return cfg.hasSanityCheck }
      }
      steps {
        lock(ubuntuBuildResource) {
          script {
            runSanityCheck()
          }
        }
      }
      post {
        failure {
          script {
            recordFailure()
          }
        }
      }
    }

    // Exercises the whole 5G Core against this NF's freshly built image; per-test NF coverage in nfConfig.
    stage('5G Core Network Integration Testing') {
      parallel {
        stage('Testing the tutorials') {
          when {
            expression { return params.doTutorialsTest && cfg.hasTutorialsTest }
          }
          steps {
            script {
              runTestJob('OAI-CN5G-Tutorials-Check', 'Tutorials Test Job')
            }
          }
          post {
            always {
              script {
                collectTestReport('OAI-CN5G-Tutorials-Check', 'tutorials-report', '*_results_oai_cn5g*.html')
              }
            }
            success {
              script {
                notifyStageStatus('SUCCESS', 'Passed')
              }
            }
            failure {
              script {
                recordFailure(latestArchivedReportLink('tutorials-report'))
              }
            }
          }
        }

        stage('Testing with COTS-UE') {
          when {
            expression { return params.doCotsUeTest && cfg.hasCotsUeTest }
          }
          steps {
            script {
              runTestJob('OAI-CN5G-COTS-UE-Test', 'COTS-UE Test Job')
            }
          }
          post {
            always {
              script {
                collectTestReport('OAI-CN5G-COTS-UE-Test', 'cots-ue-report', '*_results_oai_cn5g*.html')
              }
            }
            success {
              script {
                notifyStageStatus('SUCCESS', 'Passed')
              }
            }
            failure {
              script {
                recordFailure(latestArchivedReportLink('cots-ue-report'))
              }
            }
          }
        }

        stage('Load Testing') {
          when {
            expression { return params.doLoadTest && cfg.hasLoadTest }
          }
          steps {
            script {
              runTestJob('OAI-CN5G-Load-Test', 'Load Testing Job')
            }
          }
          post {
            always {
              script {
                collectTestReport('OAI-CN5G-Load-Test', 'load-test-report', '*_results_oai_cn5g*.html')
              }
            }
            success {
              script {
                notifyStageStatus('SUCCESS', 'Passed')
              }
            }
            failure {
              script {
                recordFailure(latestArchivedReportLink('load-test-report'))
              }
            }
          }
        }

        stage('Testing the tutorials with eBPF') {
          when {
            expression { return params.doEbpfTutorialsTest && cfg.hasEbpfTutorialsTest }
          }
          steps {
            script {
              runTestJob('OAI-CN5G-Tutorials-Check-eBPF', 'eBPF Tutorials Test Job')
            }
          }
          post {
            always {
              script {
                collectTestReport('OAI-CN5G-Tutorials-Check-eBPF', 'tutorials-ebpf-report', '*_results_oai_cn5g*.html')
              }
            }
            success {
              script {
                notifyStageStatus('SUCCESS', 'Passed')
              }
            }
            failure {
              script {
                recordFailure(latestArchivedReportLink('tutorials-ebpf-report'))
              }
            }
          }
        }

        stage('Robot-Test') {
          when {
            expression { return params.doRobotTest && cfg.hasRobotTest }
          }
          steps {
            script {
              runTestJob('OAI-CN5G-RobotTest', 'Robot Test Job')
            }
          }
          post {
            always {
              script {
                collectTestReport('OAI-CN5G-RobotTest', 'robot-test-report', '*.html, archives/report.html, archives/log.html')
              }
            }
            success {
              script {
                notifyStageStatus('SUCCESS', 'Passed')
              }
            }
            failure {
              script {
                recordFailure(latestArchivedReportLink('robot-test-report', 'archives/report.html'))
              }
            }
          }
        }

        stage('Robot-NorthBound-Test') {
          when {
            expression { return params.doRobotNorthBoundTest && cfg.hasRobotNorthBoundTest }
          }
          steps {
            script {
              runTestJob('OAI-CN5G-RobotTest-NorthBound-Testing', 'Robot NorthBound Test Job')
            }
          }
          post {
            always {
              script {
                collectTestReport('OAI-CN5G-RobotTest-NorthBound-Testing', 'robot-northbound-test-report', '*.html, archives/report.html, archives/log.html')
              }
            }
            success {
              script {
                notifyStageStatus('SUCCESS', 'Passed')
              }
            }
            failure {
              script {
                recordFailure(latestArchivedReportLink('robot-northbound-test-report', 'archives/report.html'))
              }
            }
          }
        }
      }
    }
  }

  post {
    always {
      echo "Build finished for ${NF}: ${currentBuild.currentResult}"
    }
    success {
      script {
        if (isPullRequest) {
          def message = "**CI Build:** [#${env.BUILD_NUMBER}](${BUILD_URL}) | **Passed**"
          if (mrValidationWarning) {
            message += "\n\n**Validation:** ${mrValidationWarning}"
          }
          githubPRComment comment: githubPRMessage(message)
        }
        notifyGitHub('SUCCESS', 'Build success', env.JOB_BASE_NAME)
        echo "Pipeline is SUCCESSFUL"
      }
    }
    failure {
      script {
        if (isPullRequest || env.GITHUB_PR_NUMBER) {
          def message = "**CI Build:** [#${env.BUILD_NUMBER}](${BUILD_URL}) | **Failed**"
          if (failingStages) {
            message += " on the following stages:${failingStages}"
          } else {
            message += "\nThe pipeline may have failed due to CI, validation, or scripting error. See the build for more details."
          }
          if (preBuildFailureMessage) {
            message += "\n\n${preBuildFailureMessage}"
          }
          if (mrValidationWarning) {
            message += "\n\n**Validation:** ${mrValidationWarning}"
          }
          try { githubPRComment comment: githubPRMessage(message) }
          catch (e) { echo "Could not post PR comment: ${e.message}" }
        }
        notifyGitHub('FAILURE', 'Build failed', env.JOB_BASE_NAME)
        echo "Pipeline FAILED"
      }
    }
    cleanup {
      script {
        generateAndArchiveReports()
      }
    }
  }
}

// Check out GitHub's precomputed PR-merge ref (refs/pull/<N>/merge) so we build
// exactly what GitHub considers mergeable; a missing ref means a conflict
def checkoutSource() {
  if (isPullRequest) {
    echo "PR triggered - checking out merge ref for PR #${env.GITHUB_PR_NUMBER}"
    try {
      checkout([
        $class: 'GitSCM',
        branches: [[name: "refs/remotes/origin/pr/${env.GITHUB_PR_NUMBER}/merge"]],
        userRemoteConfigs: [[
          url: env.GIT_URL,
          refspec: "+refs/pull/${env.GITHUB_PR_NUMBER}/merge:refs/remotes/origin/pr/${env.GITHUB_PR_NUMBER}/merge",
          credentialsId: githubCredentialsId
        ]]
      ])
    } catch (e) {
      error("Checkout failed for PR #${env.GITHUB_PR_NUMBER} -- merge ref not found. " +
            "The PR likely has a conflict with ${targetBranch} that must be resolved before CI can run. (${e.message})")
    }
  } else {
    echo "Push triggered - checking out ${env.GIT_COMMIT} on branch ${nf_branch}"
    try {
      checkout([
        $class: 'GitSCM',
        branches: [[name: env.GIT_COMMIT]],
        userRemoteConfigs: [[
          url: env.GIT_URL,
          credentialsId: githubCredentialsId
        ]]
      ])
    } catch (e) {
      error("Checkout failed for commit ${env.GIT_COMMIT} on branch ${nf_branch} from ${env.GIT_URL}. (${e.message})")
    }
  }
}

// emitCheck=false: record in the PR comment only, let a parent stage emit one rolled-up check.
def recordFailure(String reportLink = null, boolean emitCheck = true) {
  failingStages += reportLink ? "\n * [${env.STAGE_NAME}](${reportLink})" : "\n * ${env.STAGE_NAME}"
  if (emitCheck) {
    notifyStageStatus('FAILURE', 'Failed')
  }
}

// Post a GitHub commit status; PR builds target the PR head, push builds the triggering commit.
def notifyGitHub(String status, String description, String context, String targetUrl = null) {
  def sha = isPullRequest ? env.GITHUB_PR_HEAD_SHA : env.GIT_COMMIT
  if (!sha) {
    echo "Skipping GitHub notification for '${context}': no commit SHA"
    return
  }
  githubNotify account: params.gitAccount,
               repo: params.gitRepo,
               credentialsId: githubCredentialsId,
               sha: sha,
               status: status,
               description: description,
               targetUrl: targetUrl ?: BUILD_URL,
               context: context
}

// Per-stage check (context = stage name); test stages link to their downstream build, else this one.
def notifyStageStatus(String status, String description) {
  notifyGitHub(status, description, env.STAGE_NAME, downstreamUrls[env.STAGE_NAME])
}

// Build report archived in the cleanup block; holds cppcheck and clang-format results.
def nfReportLink() {
  return "${env.BUILD_URL}artifact/test_results_oai_${nf}.html"
}

// Runs a downstream test job with this NF's tag/branch; fails the stage on a bad result.
def runTestJob(String jobName, String failureLabel) {
  def localStatus = build job: jobName,
    parameters: [
      string(name: "${NF}_TAG", value: nf_tag),
      string(name: "${NF}_BRANCH", value: nf_branch)
    ], propagate: false
  downstreamUrls[env.STAGE_NAME] = localStatus.absoluteUrl
  if (!localStatus.resultIsBetterOrEqualTo('SUCCESS')) {
    error "${failureLabel} Failed"
  }
}

// Copy + archive the downstream job's HTML report into reportDir (filterPattern may be comma-separated).
def collectTestReport(String jobName, String reportDir, String filterPattern) {
  copyArtifacts(projectName: jobName,
                filter: filterPattern,
                selector: lastCompleted(),
                target: reportDir,
                optional: true)
  def archivePatterns = filterPattern.split(',').collect { "${reportDir}/${it.trim()}" }.join(', ')
  archiveArtifacts artifacts: archivePatterns, allowEmptyArchive: true
}

// URL of the HTML report just archived under reportDir by this stage's `always` post block, if any.
def latestArchivedReportLink(String reportDir, String filterPattern = '*_results_oai_cn5g*.html') {
  def reportFiles = sh(returnStdout: true, script: "ls ${reportDir}/${filterPattern} 2>/dev/null || true").trim()
  if (!reportFiles) {
    return null
  }
  def firstReport = reportFiles.split('\n')[0]
  return "${env.BUILD_URL}artifact/${firstReport}"
}

// Retags the private-registry image as develop on Docker Hub via the multi-arch manifest for PUSH to develop
def publishToDockerHub() {
  withCredentials([
    [$class: 'UsernamePasswordMultiBinding', credentialsId: dockerHubCredentialsId, usernameVariable: 'DH_Username', passwordVariable: 'DH_Password']
  ]) {
    sh 'echo "$DH_Password" | docker login --username "$DH_Username" --password-stdin'
  }
  withCredentials([
    [$class: 'UsernamePasswordMultiBinding', credentialsId: privateRegistryCredentialsId, usernameVariable: 'REGISTRY_USERNAME', passwordVariable: 'REGISTRY_PASSWORD']
  ]) {
    sh "echo \"\$REGISTRY_PASSWORD\" | docker login --username \"\$REGISTRY_USERNAME\" --password-stdin ${PrivateRegistryURL}"
  }
  sh "docker buildx imagetools create -t ${DH_Account}/oai-${nf}:develop ${PrivateRegistryURL}/oai-${nf}:${nf_tag}"
  sh "docker rmi ${DH_Account}/oai-${nf}:develop ${PrivateRegistryURL}/oai-${nf}:${nf_tag} || true"
  sh "docker logout ${PrivateRegistryURL}"
  sh "docker logout"
}

// Generate and archive the HTML report, Trivy report, and a zip of archives/.
// PR title is untrusted: passed via a quoted env var and sanitized in Python.
def generateAndArchiveReports() {
  if (!cfg || !fileExists('ci-scripts/common/python/generateHtmlReport.py')) {
    echo 'Skipping HTML report -- workspace was never checked out'
    return
  }
  def unitTestsFlag = cfg.hasUnitTests ? '--has-unit-tests' : ''
  if (isPullRequest) {
    withEnv(["PR_TITLE=${env.GITHUB_PR_TITLE}"]) {
      sh "./ci-scripts/common/python/generateHtmlReport.py --nf ${nf} ${unitTestsFlag} --job-name ${JOB_NAME} --build-id ${BUILD_ID} --build-url ${env.BUILD_URL} --git-url ${env.GIT_URL} --git-src-branch ${nf_branch} --git-src-commit ${env.GITHUB_PR_HEAD_SHA} --git-pull-request --git-dst-branch ${targetBranch} --git-dst-commit ${env.GIT_COMMIT} --build-time \"${env.JOB_TIMESTAMP}\" --pr-url ${env.GITHUB_PR_URL} --pr-title \"\$PR_TITLE\""
    }
  } else {
    sh "./ci-scripts/common/python/generateHtmlReport.py --nf ${nf} ${unitTestsFlag} --job-name ${JOB_NAME} --build-id ${BUILD_ID} --build-url ${env.BUILD_URL} --git-url ${env.GIT_URL} --git-src-branch ${nf_branch} --git-src-commit ${env.GIT_COMMIT} --build-time \"${env.JOB_TIMESTAMP}\""
  }

  def listOfFiles = sh(returnStdout: true, script: 'ls test_results*.html 2>/dev/null || true').trim()
  if (listOfFiles) {
    String[] htmlFiles = listOfFiles.split("\\n")
    for (htmlFile in htmlFiles) {
      archiveArtifacts artifacts: htmlFile
    }
  }

  // Zipping all archived log files
  if (fileExists("archives/${nf}_multiarch_image_trivy_report.html")) {
    archiveArtifacts artifacts: "archives/${nf}_multiarch_image_trivy_report.html"
  }
  sh "zip -r -qq oai_${nf}_logs.zip archives -x archives/${nf}_multiarch_image_trivy_report.html"
  if (fileExists("oai_${nf}_logs.zip")) {
    archiveArtifacts artifacts: "oai_${nf}_logs.zip"
  }
}

// Multi-arch Ubuntu image build pushed to the private registry, optionally Trivy-scanned.
def buildUbuntuImage() {
  sh "docker image rm oai-${nf}:${nf_tag} ${PrivateRegistryURL}/oai-${nf}:${nf_tag} || true"
  def dockerBuildOptions = isPullRequest ? '' : '--no-cache '
  withCredentials([
    [$class: 'UsernamePasswordMultiBinding', credentialsId: privateRegistryCredentialsId, usernameVariable: 'REGISTRY_USERNAME', passwordVariable: 'REGISTRY_PASSWORD']
  ]) {
    sh "echo \"\$REGISTRY_PASSWORD\" | docker login --username \"\$REGISTRY_USERNAME\" --password-stdin ${PrivateRegistryURL}"
  }
  sh """
    docker buildx build ${dockerBuildOptions} \
      --target oai-${nf} \
      --tag ${PrivateRegistryURL}/oai-${nf}:${nf_tag} \
      --platform linux/amd64,linux/arm64 \
      --build-arg GIT_COMMIT="${shortenShaOne}" \
      --file docker/Dockerfile.${nf}.ubuntu \
      --builder multiarch-localremote-builder \
      --progress=plain \
      --push . > archives/${nf}_ubuntu_image_build.log 2>&1
  """
  sh "docker image prune --force"
  sh "docker pull ${PrivateRegistryURL}/oai-${nf}:${nf_tag}"
  sh "docker image inspect ${PrivateRegistryURL}/oai-${nf}:${nf_tag} | jq '.[0] | {RepoTags, Labels: .Config.Labels, DockerVersion}' >> archives/${nf}_ubuntu_image_build.log 2>&1"
  sh "docker images ${PrivateRegistryURL}/oai-${nf}:${nf_tag} >> archives/${nf}_ubuntu_image_build.log 2>&1"
  if (runTrivyScan) {
    sh "docker image tag ${PrivateRegistryURL}/oai-${nf}:${nf_tag} oai-${nf}:${shortenShaOne}"
    sh "trivy image --exit-code 1 --severity MEDIUM,HIGH,CRITICAL --no-progress --format=template --template @./ci-scripts/common/html-templates/trivy_html.tpl --output archives/${nf}_multiarch_image_trivy_report.html oai-${nf}:${shortenShaOne} > /dev/null || true"
  }
  sh "docker rmi ${PrivateRegistryURL}/oai-${nf}:${nf_tag} oai-${nf}:${shortenShaOne} || true"
  sh "docker logout ${PrivateRegistryURL}"
  sh "bash ./ci-scripts/common/bash/extract_arm_amd_logs.sh archives/${nf}_ubuntu_image_build.log"
}

// Pulls the image just built from the private registry and runs the sanity check.
// Build and run the cppcheck static analysis image on its own agent; logs land in archives/.
def runStaticCodeAnalysis() {
  prepareWorkspace()
  sh "date --rfc-email > ${commonSrcPath}/date.txt"
  sh "sed -e 's@nfName@${nf}@' ${cppcheckDockerfile} > ${cppcheckDockerfileTmp}"
  sh "docker build --target ${nf}-cppcheck --tag ${nf}-cppcheck:test --file ${cppcheckDockerfileTmp} . > archives/cppcheck_install.log 2>&1"
  sh "docker rm -f ${nf}-ci-cppcheck || true"
  sh "docker run --name ${nf}-ci-cppcheck --entrypoint /bin/true ${nf}-cppcheck:test"
  sh "docker cp ${nf}-ci-cppcheck:/home/cppcheck.xml archives"
  sh "docker cp ${nf}-ci-cppcheck:/home/cppcheck_build.log archives"
}

// Build and run the clang-format check image on its own agent; logs land in archives/.
def runCodeFormattingChecker() {
  prepareWorkspace()
  sh "date --rfc-email > ${commonSrcPath}/date.txt"
  sh "sed -e 's@nfName@${nf}@' ${clangFormatDockerfile} > ${clangFormatDockerfileTmp}"
  if (isPullRequest) {
    sh "docker build --target ${nf}-clang-format-check --tag ${nf}-clang-format-check:test --file ${clangFormatDockerfileTmp} --build-arg EXTRA_ARGS=\"--src-branch ${nf_branch} --target-branch ${targetBranch}\" . > archives/clang_format_install.log 2>&1"
  } else {
    sh "docker build --target ${nf}-clang-format-check --tag ${nf}-clang-format-check:test --file ${clangFormatDockerfileTmp} . > archives/clang_format_install.log 2>&1"
  }
  sh "docker rm -f ${nf}-ci-clang-format || true"
  sh "docker run --name ${nf}-ci-clang-format --entrypoint /bin/true ${nf}-clang-format-check:test"
  sh "docker cp ${nf}-ci-clang-format:/home/src/oai_rules_result.txt src"
  sh "docker cp ${nf}-ci-clang-format:/home/src/oai_rules_result_list.txt src || true"
  sh '''
    if grep -q "NB_FILES_FAILING_CHECK=0" src/oai_rules_result.txt; then
      exit 0
    else
      echo "The following files do not follow OAI coding/formatting rules:"
      cat src/oai_rules_result_list.txt
      exit 1
    fi
  '''
}

// Sanity checks
def runSanityCheck() {
  withCredentials([
    [$class: 'UsernamePasswordMultiBinding', credentialsId: privateRegistryCredentialsId, usernameVariable: 'REGISTRY_USERNAME', passwordVariable: 'REGISTRY_PASSWORD']
  ]) {
    sh "echo \"\$REGISTRY_PASSWORD\" | docker login --username \"\$REGISTRY_USERNAME\" --password-stdin ${PrivateRegistryURL}"
  }
  sh "docker pull ${PrivateRegistryURL}/oai-${nf}:${nf_tag}"
  sh "docker image tag ${PrivateRegistryURL}/oai-${nf}:${nf_tag} oai-${nf}:${nf_tag}"
  sh "python3 ./ci-scripts/sanityCheckDeploy.py --tag oai-${nf}:${nf_tag}"
  sh "docker rmi oai-${nf}:${nf_tag} ${PrivateRegistryURL}/oai-${nf}:${nf_tag} || true"
  sh "docker logout ${PrivateRegistryURL}"
}

def prepareWorkspace() {
  deleteDir() // Wipe the workspace before checking out
  checkoutSource()
  sh 'git config user.email "oaicicdteam@openairinterface.org"'
  sh 'git config user.name "OAI Jenkins"'
  // -c scopes the credential helper to just this command, unlike a persisted `git config` write.
  withCredentials([
    [$class: 'UsernamePasswordMultiBinding', credentialsId: githubCredentialsId, usernameVariable: 'GITHUB_USERNAME', passwordVariable: 'GITHUB_TOKEN']
  ]) {
    sh '''
      git -c credential.helper='!f() { echo "username=$GITHUB_USERNAME"; echo "password=$GITHUB_TOKEN"; }; f' submodule update --init --recursive
    '''
  }
  sh "mkdir -p archives"
}
